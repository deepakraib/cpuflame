#!/usr/bin/env python3
"""Build interactive flame graphs from Linux perf without the Perl helpers.

Width is inclusive time: a frame covers itself and everything it called.
The bottom row is the root. Click a frame to zoom, type to search.
"""

from __future__ import annotations

import argparse
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import zlib
from dataclasses import dataclass
from html import escape


XPAD = 10
HEADER = 76
FRAME_H = 16
BOTTOM = 14

FRAME_RE = re.compile(r"^\s+[0-9a-fA-F]+\s+\S")
MODULE_RE = re.compile(r"^\s+[0-9a-fA-F]+\s+(.*)\s+\(([^()]*)\)\s*$")
PLAIN_RE = re.compile(r"^\s+[0-9a-fA-F]+\s+(\S.*?)\s*$")
OFFSET_RE = re.compile(r"\+0x[0-9a-fA-F]+(?:/0x[0-9a-fA-F]+)?$")
TS_RE = re.compile(r"(?:^|\s)\d+\.\d+:")
FOLDED_RE = re.compile(r"^(.*\S)\s+([0-9]+(?:\.[0-9]+)?)\s*$")

SCRIPT = r"""
function init() {
  var svg = document.documentElement;
  var plotWidth = parseFloat(svg.getAttribute("data-plot-width"));
  var xpad = parseFloat(svg.getAttribute("data-xpad"));
  var frames = Array.prototype.slice.call(document.querySelectorAll("g.frame"));
  var query = "";
  var searchLabel = document.getElementById("searchlabel");
  var details = document.getElementById("details");

  function place(g, x, y, w) {
    var box = g.querySelector("rect.box");
    var clip = g.querySelector("rect.clip");
    var text = g.querySelector("text.label");
    box.setAttribute("x", x);
    box.setAttribute("y", y);
    box.setAttribute("width", w);
    clip.setAttribute("x", x);
    clip.setAttribute("y", y);
    clip.setAttribute("width", w);
    text.setAttribute("x", x + 3);
    text.setAttribute("y", y + 12);
    text.style.display = w < 36 ? "none" : "";
  }

  function applySearch() {
    var q = query.toLowerCase();
    var hits = 0;
    for (var i = 0; i < frames.length; i++) {
      var f = frames[i];
      var box = f.querySelector("rect.box");
      var name = f.getAttribute("data-name").toLowerCase();
      if (!q) {
        box.setAttribute("fill", f.getAttribute("data-fill"));
      } else if (name.indexOf(q) !== -1) {
        hits++;
        box.setAttribute("fill", "#b06ad6");
      } else {
        box.setAttribute("fill", "#d5d5d5");
      }
    }
    if (q) {
      var noun = hits === 1 ? " frame" : " frames";
      searchLabel.textContent = "search: " + query + "  (" + hits + noun + ", Enter zooms to the first)";
    } else {
      searchLabel.textContent = "Type to search. Click a frame to zoom. Esc clears.";
    }
  }

  function reset() {
    for (var i = 0; i < frames.length; i++) {
      var f = frames[i];
      f.style.display = "";
      place(
        f,
        parseFloat(f.getAttribute("data-ox")),
        parseFloat(f.getAttribute("data-oy")),
        parseFloat(f.getAttribute("data-ow"))
      );
    }
    details.textContent = "Hover a frame for samples and percentages.";
    applySearch();
  }

  function zoom(g) {
    var ox = parseFloat(g.getAttribute("data-ox"));
    var oy = parseFloat(g.getAttribute("data-oy"));
    var ow = parseFloat(g.getAttribute("data-ow"));
    var id = g.getAttribute("id");
    var headerY = parseFloat(svg.getAttribute("data-header"));
    if (!(ow > 0)) return;
    var prefix = id + "_";
    var members = [];
    var top = oy;
    for (var i = 0; i < frames.length; i++) {
      var f = frames[i];
      var fid = f.getAttribute("id");
      var inside = fid === id || fid.indexOf(prefix) === 0;
      if (!inside) {
        f.style.display = "none";
        continue;
      }
      members.push(f);
      var fy = parseFloat(f.getAttribute("data-oy"));
      if (fy < top) top = fy;
    }
    var shift = headerY - top;
    for (var j = 0; j < members.length; j++) {
      var member = members[j];
      member.style.display = "";
      var fx = parseFloat(member.getAttribute("data-ox"));
      var memberY = parseFloat(member.getAttribute("data-oy"));
      var fw = parseFloat(member.getAttribute("data-ow"));
      place(member, xpad + ((fx - ox) / ow) * plotWidth, memberY + shift, (fw / ow) * plotWidth);
    }
    applySearch();
    details.textContent = g.getAttribute("data-tip");
  }

  for (var i = 0; i < frames.length; i++) {
    (function(f) {
      f.addEventListener("mouseover", function(ev) {
        ev.stopPropagation();
        details.textContent = f.getAttribute("data-tip");
      });
      f.addEventListener("click", function(ev) {
        ev.stopPropagation();
        zoom(f);
      });
    })(frames[i]);
  }

  document.getElementById("unzoom").addEventListener("click", function(ev) {
    ev.stopPropagation();
    reset();
  });

  window.addEventListener("keydown", function(ev) {
    if (ev.key === "Escape") {
      if (query) query = "";
      else reset();
      applySearch();
      ev.preventDefault();
      return;
    }
    if (ev.key === "Backspace") {
      query = query.slice(0, -1);
      applySearch();
      ev.preventDefault();
      return;
    }
    if (ev.key === "Enter") {
      var q = query.toLowerCase();
      for (var n = 0; n < frames.length; n++) {
        var visible = frames[n].style.display !== "none";
        var name = frames[n].getAttribute("data-name").toLowerCase();
        if (visible && q && name.indexOf(q) !== -1) {
          zoom(frames[n]);
          break;
        }
      }
      ev.preventDefault();
      return;
    }
    if (ev.key.length === 1 && !ev.ctrlKey && !ev.metaKey && !ev.altKey) {
      query += ev.key;
      applySearch();
      ev.preventDefault();
    }
  });

  applySearch();
