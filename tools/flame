"""


@dataclass(frozen=True)
class Frame:
    name: str
    kind: str


class Node:
    def __init__(self, frame: Frame):
        self.frame = frame
        self.samples = 0
        self.children: dict[Frame, Node] = {}

    def child(self, frame: Frame) -> Node:
        node = self.children.get(frame)
        if node is None:
            node = Node(frame)
            self.children[frame] = node
        return node

    def self_samples(self) -> float:
        return self.samples - sum(child.samples for child in self.children.values())


@dataclass
class Box:
    id: str
    name: str
    kind: str
    samples: float
    self_samples: float
    parent_samples: float
    depth: int
    x: float
    y: float
    width: float


def clean_name(name: str) -> str:
    name = " ".join(name.split())
    if len(name) > 400:
        name = name[:397] + "..."
    return name or "[unnamed]"


def tidy(symbol: str, module: str) -> Frame:
    symbol = symbol.strip()
    module = module.strip()
    if module == "inline":
        symbol = f"{symbol} [inline]"
        module = ""
    symbol = OFFSET_RE.sub("", symbol).strip()
    kind = "kernel" if "kernel" in module.lower() else "user"
    if symbol in ("[unknown]", ""):
        base = module.rsplit("/", 1)[-1] if module else "unknown"
        symbol = f"[unknown] {base}"
    return Frame(clean_name(symbol), kind)


def parse_frame(line: str) -> Frame:
    match = MODULE_RE.match(line)
    if match:
        return tidy(match.group(1), match.group(2))
    match = PLAIN_RE.match(line)
    if match:
        return tidy(match.group(1), "")
    return Frame("[unparsed]", "user")


def parse_comm(line: str) -> str:
    parts = line.split()
    return parts[0] if parts else "?"


def add_sample(root: Node, frames: list[Frame], weight: float) -> None:
    root.samples += weight
    node = root
    for frame in frames:
        node = node.child(frame)
        node.samples += weight


def load_perf_script(text: str, include_comm: bool, comm_filter: set[str]) -> Node:
    root = Node(Frame("all", "root"))
    current_comm: str | None = None
    leaf_first: list[Frame] = []
    saw_header = False

    def flush() -> None:
        nonlocal current_comm, leaf_first
        if current_comm is None:
            return
        comm = current_comm
        frames = leaf_first
        current_comm = None
        leaf_first = []
        if comm_filter and comm not in comm_filter:
            return
        stack = list(reversed(frames))
        if not stack:
            stack = [Frame("[no stack]", "user")]
        if include_comm:
            stack = [Frame(clean_name(comm), "comm")] + stack
        add_sample(root, stack, 1)

    for line in text.splitlines():
        if not line.strip() or line.startswith("#"):
            if not line.strip() and current_comm is not None:
                flush()
            continue
        if FRAME_RE.match(line):
            if current_comm is None:
                current_comm = "?"
            leaf_first.append(parse_frame(line))
            continue
        if TS_RE.search(line):
            flush()
            saw_header = True
            current_comm = parse_comm(line)
            leaf_first = []
            continue
    flush()

    if root.samples == 0:
        if comm_filter and saw_header:
            raise SystemExit(
                "No samples matched --comm. "
                "The filter is the process name from the perf script header (the first field)."
            )
        raise SystemExit(
            "No samples found. Expected `perf script` output: a header line, then indented stack frames."
        )
    return root


def load_folded(text: str, comm_filter: set[str]) -> Node:
    root = Node(Frame("all", "root"))
    skipped = 0
    for line in text.splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        match = FOLDED_RE.match(line)
        if not match:
            skipped += 1
            continue
        names = [clean_name(part) for part in match.group(1).split(";") if part.strip()]
        if not names:
            skipped += 1
            continue
        if comm_filter and names[0] not in comm_filter:
            continue
        weight = float(match.group(2)) if "." in match.group(2) else int(match.group(2))
        add_sample(root, [Frame(name, "user") for name in names], weight)
    if root.samples == 0:
        if comm_filter:
            raise SystemExit("No folded stacks matched --comm. For folded input the first frame is the process name.")
        if skipped:
            raise SystemExit("No folded stacks found. Expected lines like: main;foo;bar 12")
        raise SystemExit("No samples found.")
    return root


def detect_format(text: str) -> str:
    checked = 0
    for line in text.splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        checked += 1
        if FRAME_RE.match(line) or TS_RE.search(line):
            return "script"
        if checked >= 40:
            break
    return "folded"


def load_text(text: str, fmt: str, include_comm: bool, comm_filter: set[str]) -> Node:
    kind = detect_format(text) if fmt == "auto" else fmt
    if kind == "script":
        return load_perf_script(text, include_comm, comm_filter)
    return load_folded(text, comm_filter)


def color_for(name: str, kind: str) -> str:
    if kind == "root":
        return "rgb(188,188,188)"
    digest = zlib.crc32(name.encode()) & 0xFFFFFFFF
    if kind == "comm":
        red = 50 + (digest % 30)
        green = 100 + ((digest >> 8) % 40)
        blue = 150 + ((digest >> 16) % 40)
    elif kind == "kernel":
        red = 185 + (digest % 45)
        green = 65 + ((digest >> 8) % 45)
        blue = 25 + ((digest >> 16) % 25)
    else:
        red = 210 + (digest % 45)
        green = 85 + ((digest >> 8) % 110)
        blue = 20 + ((digest >> 16) % 30)
    return f"rgb({red},{green},{blue})"


def layout(root: Node, width: int, min_width: float, icicle: bool) -> list[Box]:
    plot = width - 2 * XPAD
    placed: list[tuple[Node, float, float, int, str, float]] = []

    def walk(node: Node, x: float, depth: int, ident: str, parent_samples: float) -> None:
        span = plot * (node.samples / root.samples) if root.samples else 0
        if depth == 0 or (span > 0 and span + 1e-9 >= min_width):
            placed.append((node, x, span, depth, ident, parent_samples))
            cx = x
            children = sorted(node.children.values(), key=lambda item: (item.frame.name, item.frame.kind))
            for index, child in enumerate(children):
                child_span = plot * (child.samples / root.samples) if root.samples else 0
                if child_span > 0 and child_span + 1e-9 >= min_width:
                    walk(child, cx, depth + 1, f"{ident}_{index}", node.samples)
                cx += child_span

    walk(root, XPAD, 0, "f", root.samples)
    max_depth = max(item[3] for item in placed)

    def y_of(depth: int) -> float:
        if icicle:
            return HEADER + depth * FRAME_H
        return HEADER + (max_depth - depth) * FRAME_H

    boxes: list[Box] = []
    for node, x, span, depth, ident, parent_samples in placed:
        boxes.append(
            Box(
                id=ident,
                name=node.frame.name,
                kind=node.frame.kind,
                samples=node.samples,
                self_samples=node.self_samples(),
                parent_samples=parent_samples,
                depth=depth,
                x=x,
                y=y_of(depth),
                width=span,
            )
        )
    return boxes


def count_nodes(node: Node) -> int:
    return 1 + sum(count_nodes(child) for child in node.children.values())


def fmt_num(value: float) -> str:
    if isinstance(value, float) and not value.is_integer():
        return f"{value:,.2f}"
    return f"{int(round(value)):,}"


def tip(box: Box, root_samples: float) -> str:
    total = 100.0 * box.samples / root_samples if root_samples else 0
    parent = 100.0 * box.samples / box.parent_samples if box.parent_samples else 100
    self_pct = 100.0 * box.self_samples / root_samples if root_samples else 0
    return (
        f"{box.name} — {fmt_num(box.samples)} samples, "
        f"{total:.1f}% of total, {parent:.1f}% of parent, "
        f"self {fmt_num(box.self_samples)} ({self_pct:.1f}%)"
    )


def fit_title(title: str, width: int) -> str:
    max_chars = max(12, (width - 160) // 8)
    if len(title) <= max_chars:
        return title
    return title[: max_chars - 1] + "…"


def write_svg(path: str, boxes: list[Box], root_samples: float, title: str, width: int) -> None:
    max_depth = max(box.depth for box in boxes)
    height = HEADER + (max_depth + 1) * FRAME_H + BOTTOM
    plot = width - 2 * XPAD
    chunks = [
        '<?xml version="1.0" encoding="UTF-8"?>\n',
        (
            f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" '
            f'onload="init()" data-plot-width="{plot}" data-xpad="{XPAD}" data-header="{HEADER}">\n'
        ),
        "<style>\n",
        "svg { user-select: none; background: #f6f6f6; }\n",
        "text { font-family: Verdana, sans-serif; font-size: 12px; }\n",
        "text.title { font-size: 16px; font-weight: bold; }\n",
        "text.label { font-size: 12px; fill: #161616; }\n",
        "#unzoom { cursor: pointer; fill: #0645ad; }\n",
        "g.frame { cursor: pointer; }\n",
        "rect.box { stroke: #ffffff; stroke-width: 0.4; }\n",
        "</style>\n",
        "<script type=\"text/ecmascript\"><![CDATA[\n",
        SCRIPT,
        "]]></script>\n",
        f'<rect id="bg" x="0" y="0" width="{width}" height="{height}" fill="#f6f6f6"/>\n',
        f'<text class="title" x="10" y="24">{escape(fit_title(title, width))}</text>\n',
        f'<text id="unzoom" x="{width - 110}" y="24">Reset zoom</text>\n',
        '<text id="details" x="10" y="46" fill="#333">Hover a frame for samples and percentages.</text>\n',
        '<text id="searchlabel" x="10" y="66" fill="#555">Type to search. Click a frame to zoom. Esc clears.</text>\n',
    ]
    for box in chunks_boxes(boxes, root_samples):
        chunks.append(box)
    chunks.append("</svg>\n")
    parent = os.path.dirname(os.path.abspath(path))
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(path, "w", encoding="utf-8") as handle:
        handle.write("".join(chunks))


def chunks_boxes(boxes: list[Box], root_samples: float) -> list[str]:
    rows: list[str] = []
    for box in boxes:
        fill = color_for(box.name, box.kind)
        hidden = ' style="display:none"' if box.width < 36 else ""
        label = escape(box.name)
        detail = escape(tip(box, root_samples), quote=True)
        name_attr = escape(box.name, quote=True)
        rows.append(
            f'<g class="frame" id="{box.id}" data-name="{name_attr}" data-fill="{fill}" '
            f'data-ox="{box.x:.2f}" data-oy="{box.y:.2f}" data-ow="{box.width:.2f}" data-tip="{detail}">\n'
            f"<title>{detail}</title>\n"
            f'<clipPath id="c{box.id}"><rect class="clip" x="{box.x:.2f}" y="{box.y:.2f}" '
            f'width="{box.width:.2f}" height="{FRAME_H}"/></clipPath>\n'
            f'<rect class="box" x="{box.x:.2f}" y="{box.y:.2f}" width="{box.width:.2f}" '
            f'height="{FRAME_H}" fill="{fill}"/>\n'
            f'<text class="label" x="{box.x + 3:.2f}" y="{box.y + 12:.2f}" clip-path="url(#c{box.id})"{hidden}>{label}</text>\n'
            "</g>\n"
        )
    return rows


def emit(path: str, root: Node, title: str, width: int, min_width: float, icicle: bool, open_after: bool) -> None:
    if width < 240:
        raise SystemExit("--width must be at least 240")
    if min_width < 0:
        raise SystemExit("--min-width cannot be negative")
    if root.samples <= 0:
        raise SystemExit("No samples to draw.")
    boxes = layout(root, width, min_width, icicle)
    write_svg(path, boxes, root.samples, title, width)
    hidden = count_nodes(root) - len(boxes)
    extra = ""
    if hidden:
        extra = f" ({hidden} narrower than --min-width {min_width:g}px were left out)"
    print(f"Wrote {os.path.abspath(path)}")
    print(f"{fmt_num(root.samples)} samples, {len(boxes)} frames{extra}")
    kinds = {box.kind for box in boxes}
    legend = []
    if "comm" in kinds:
        legend.append("blue frames are process names")
    if "kernel" in kinds:
        legend.append("orange frames are kernel")
    if "user" in kinds and ("comm" in kinds or "kernel" in kinds):
        legend.append("yellow frames are user code")
    if legend:
        sentence = ", ".join(legend)
        print(sentence[0].upper() + sentence[1:] + ".")
    print("Open the SVG in a browser. Click a frame to zoom. Type to search. Esc clears.")
    if open_after:
        opener = shutil.which("xdg-open")
        if opener is None:
            print("xdg-open is not installed, so the SVG was not opened.")
        else:
            subprocess.Popen(
                [opener, os.path.abspath(path)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )


def read_paranoid() -> int | None:
    try:
        with open("/proc/sys/kernel/perf_event_paranoid", encoding="utf-8") as handle:
            return int(handle.read().strip())
    except (OSError, ValueError):
        return None


def explain_failure(detail: str) -> str:
    parts = ["perf did not capture any samples."]
    detail = (detail or "").strip()
    if detail:
        parts.append(detail)
    level = read_paranoid()
    if level is not None and level >= 3:
        parts.append(
            f"kernel.perf_event_paranoid is {level}, so a normal user cannot record profiles.\n"
            "Allow profiles of your own processes with:\n"
            "  sudo sysctl kernel.perf_event_paranoid=1\n"
            "System-wide recording (flame system) needs 0, or run flame under sudo:\n"
            "  sudo sysctl kernel.perf_event_paranoid=0"
        )
    elif level is not None and level >= 2:
        parts.append(
            f"kernel.perf_event_paranoid is {level}, so kernel stacks are blocked. "
            "User-space stacks of your own processes should still record. "
            "To include the kernel: sudo sysctl kernel.perf_event_paranoid=1"
        )
    return "\n\n".join(parts)


def require_perf() -> None:
    if shutil.which("perf") is None:
        raise SystemExit(
            "perf is not on PATH.\n"
            "Install it with:\n"
            "  sudo apt install linux-tools-common linux-tools-$(uname -r)"
        )


def perf_data_beside(svg_path: str) -> str:
    base, ext = os.path.splitext(svg_path)
    if ext.lower() == ".svg":
        return base + ".perf.data"
    return svg_path + ".perf.data"


def record_script(record_cmd: list[str], keep_path: str | None) -> str:
    require_perf()
    print("Running " + " ".join(shlex.quote(part) for part in record_cmd))
    proc = subprocess.run(record_cmd, text=True, capture_output=True)
    data_path = output_flag(record_cmd)
    size = os.path.getsize(data_path) if data_path and os.path.exists(data_path) else 0
    if size <= 0:
        detail = "\n".join(part for part in (proc.stderr, proc.stdout) if part)
        raise SystemExit(explain_failure(detail))
    if keep_path:
        parent = os.path.dirname(os.path.abspath(keep_path))
        if parent:
            os.makedirs(parent, exist_ok=True)
        shutil.copy(data_path, keep_path)
        print(f"Kept perf data at {os.path.abspath(keep_path)}")
    script = subprocess.run(["perf", "script", "-i", data_path], text=True, capture_output=True)
    if script.returncode != 0 or not script.stdout.strip():
        detail = "\n".join(part for part in (script.stderr, proc.stderr, proc.stdout) if part)
        raise SystemExit(explain_failure(detail or "perf script produced no stacks."))
    if proc.returncode != 0:
        print(
            f"perf record exited {proc.returncode}. The graph uses the samples that were captured.",
            file=sys.stderr,
        )
    return script.stdout


def output_flag(cmd: list[str]) -> str | None:
    if "-o" in cmd:
        return cmd[cmd.index("-o") + 1]
    return None


def record_command(freq: int, call_graph: str, data_path: str, pid: int | None, system: bool, recorded: list[str]) -> list[str]:
    mode = "dwarf,8192" if call_graph == "dwarf" else call_graph
    cmd = [
        "perf", "record",
        "-F", str(freq),
        "--call-graph", mode,
        "-g",
        "--no-buildid-mmap",
        "-o", data_path,
    ]
    if system:
        cmd.append("-a")
    if pid is not None:
        cmd.extend(["-p", str(pid)])
    cmd.append("--")
    cmd.extend(recorded)
    return cmd


def take_command(command: list[str]) -> list[str]:
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        raise SystemExit("Pass the program after --\n  flame run -o out.svg -- python3 app.py")
    return command


def validate_rate(freq: int, duration: float | None) -> None:
    if freq < 1 or freq > 10000:
        raise SystemExit("--freq must be between 1 and 10000")
    if duration is not None and duration <= 0:
        raise SystemExit("--duration must be greater than 0")


def run_and_draw(args: argparse.Namespace, recorded: list[str], pid: int | None, system: bool, title: str) -> None:
    validate_rate(args.freq, getattr(args, "duration", None))
    keep = perf_data_beside(args.output) if args.keep else None
    with tempfile.TemporaryDirectory(prefix="flame-") as temp_dir:
        data_path = os.path.join(temp_dir, "perf.data")
        cmd = record_command(args.freq, args.call_graph, data_path, pid, system, recorded)
        text = record_script(cmd, keep)
    root = load_perf_script(text, include_comm=not args.no_comm, comm_filter=set(args.comm))
    emit(args.output, root, title, args.width, args.min_width, args.icicle, args.open)


def cmd_run(args: argparse.Namespace) -> None:
    command = take_command(args.command)
    recorded = command
    if args.duration is not None:
        if shutil.which("timeout") is None:
            raise SystemExit("--duration needs GNU timeout from coreutils.")
        recorded = ["timeout", "--foreground", "--signal=INT", f"{args.duration:g}", *command]
        print(f"Recording {' '.join(command)} for {args.duration:g}s")
    else:
        print(f"Recording {' '.join(command)} until it exits")
    shown = " ".join(command)
    title = args.title or f"Flame graph: {shown}"
    run_and_draw(args, recorded, None, False, title)


def cmd_attach(args: argparse.Namespace) -> None:
    if not os.path.isdir(f"/proc/{args.pid}"):
        raise SystemExit(f"No process with pid {args.pid} is running.")
    print(f"Recording pid {args.pid} for {args.duration:g}s")
    title = args.title or f"Flame graph: pid {args.pid}"
    run_and_draw(args, ["sleep", f"{args.duration:g}"], args.pid, False, title)


def cmd_system(args: argparse.Namespace) -> None:
    print(f"Recording the whole system for {args.duration:g}s")
    title = args.title or "Flame graph: system"
    run_and_draw(args, ["sleep", f"{args.duration:g}"], None, True, title)


def read_graph_input(path: str) -> str:
    if path == "-":
        return sys.stdin.read()
    if not os.path.exists(path):
        raise SystemExit(f"No such file: {path}\nRecord one with: flame run -o flame.svg -- your-command")
    with open(path, "rb") as handle:
        magic = handle.read(8)
    if magic.startswith(b"PERFILE"):
        require_perf()
        script = subprocess.run(["perf", "script", "-i", path], text=True, capture_output=True)
        if script.returncode != 0:
            raise SystemExit((script.stderr or "perf script failed").strip())
        return script.stdout
    with open(path, encoding="utf-8", errors="replace") as handle:
        return handle.read()


def cmd_graph(args: argparse.Namespace) -> None:
    text = read_graph_input(args.input)
    root = load_text(text, args.format, include_comm=not args.no_comm, comm_filter=set(args.comm))
    title = args.title or "Flame graph"
    emit(args.output, root, title, args.width, args.min_width, args.icicle, args.open)


def example_tree() -> Node:
    def user(name: str) -> Frame:
        return Frame(name, "user")

    def kernel(name: str) -> Frame:
        return Frame(name, "kernel")

    rows: list[tuple[list[Frame], int]] = [
        ([Frame("python", "comm"), user("main"), user("serve"), user("handle"), user("parse_json"), user("decode")], 30),
        ([Frame("python", "comm"), user("main"), user("serve"), user("handle"), user("query"), user("find"), user("index_scan"), user("memcmp")], 90),
        ([Frame("python", "comm"), user("main"), user("serve"), user("handle"), user("query"), user("find"), user("fetch"), user("memcpy")], 40),
        ([Frame("python", "comm"), user("main"), user("serve"), user("handle"), user("query"), user("bson"), user("malloc")], 55),
        ([Frame("python", "comm"), user("main"), user("serve"), user("write"), user("compress"), user("deflate")], 22),
        ([Frame("python", "comm"), user("main"), user("serve"), user("handle"), user("query"), user("find"), user("read"), kernel("entry_SYSCALL_64"), kernel("do_syscall_64"), kernel("vfs_read")], 18),
        ([Frame("python", "comm"), user("gc"), user("collect"), user("visit")], 12),
        ([Frame("worker", "comm"), user("loop"), user("poll"), user("epoll_wait")], 20),
    ]
    root = Node(Frame("all", "root"))
    for frames, weight in rows:
        add_sample(root, frames, weight)
    return root


def cmd_example(args: argparse.Namespace) -> None:
    title = args.title or "Example flame graph"
    emit(args.output, example_tree(), title, args.width, args.min_width, args.icicle, args.open)


def cmd_check(_args: argparse.Namespace) -> None:
    perf = shutil.which("perf")
    print(f"perf: {perf or 'not found'}")
    if perf:
        version = subprocess.run(["perf", "--version"], text=True, capture_output=True)
        if version.stdout.strip():
            print(version.stdout.strip())
    level = read_paranoid()
    print(f"perf_event_paranoid: {level if level is not None else 'unreadable'}")
    if perf is None:
        print("Install perf: sudo apt install linux-tools-common linux-tools-$(uname -r)")
        raise SystemExit(1)
    if level is None:
        print("Could not read the paranoid setting. Try a short record to see if perf works.")
        return
    if level >= 3:
        print("Recording is blocked for a normal user.")
        print("Fix for your own processes: sudo sysctl kernel.perf_event_paranoid=1")
        print("Fix for system-wide profiles: sudo sysctl kernel.perf_event_paranoid=0")
        print("Until that is changed, flame graph can still draw an existing perf script or folded stacks.")
        raise SystemExit(1)
    if level >= 2:
        print("You can record user-space stacks of your own processes. Kernel stacks are hidden.")
        print("Include the kernel with: sudo sysctl kernel.perf_event_paranoid=1")
        return
    if level >= 1:
        print("You can record your own processes, including kernel stacks.")
        print("flame system needs paranoid 0 or -1, or sudo.")
        return
    print("perf can record process and system-wide profiles.")


def find_frame(node: Node, name: str) -> Node | None:
    if node.frame.name == name:
        return node
    for child in node.children.values():
        found = find_frame(child, name)
        if found is not None:
            return found
    return None


def cmd_selftest(_args: argparse.Namespace) -> None:
    checks = 0

    def expect(condition: bool, message: str) -> None:
        nonlocal checks
        checks += 1
        if not condition:
            raise SystemExit(f"self-test failed: {message}")

    script = """\
# captured for the self-test
python 100 [003] 10.500000:     250000 cpu-clock:
	7ff1 decode_utf8+0x10 (/usr/lib/libc.so.6)
	7ff1 parse_json+0x22 (/home/app/python)
	7ff1 handle_request+0x33 (/home/app/python)

python 100 [003] 10.510000: cycles:
	ffffffff81001234 do_syscall_64+0x1c ([kernel.kallsyms])
	7ff1 read+0x10 (/usr/lib/libc.so.6)
	7ff1 main+0x5 (/home/app/python)

python 100 10.520000: cpu-clock:
	7fabc std::vector<int>::push_back(int)+0x20 (/usr/lib/libstdc++.so.6)
	7fabc [unknown] (/usr/lib/x86_64-linux-gnu/libc.so.6)
	7fabc main+0x5 (/home/app/python)

other 8 [001] 10.530000:          1 cpu-clock:
	5555 clock_nanosleep+0x1 (/usr/lib/libc.so.6)
"""
    tree = load_perf_script(script, include_comm=True, comm_filter=set())
    expect(tree.samples == 4, f"expected 4 samples, got {tree.samples}")
    decode = find_frame(tree, "decode_utf8")
    expect(decode is not None and decode.samples == 1, "decode_utf8 missing")
    expect(find_frame(tree, "python") is not None, "comm frame missing")
    syscall = find_frame(tree, "do_syscall_64")
    expect(syscall is not None and syscall.frame.kind == "kernel", "kernel kind missing")
    vector = find_frame(tree, "std::vector<int>::push_back(int)")
    expect(vector is not None, "C++ symbol was not kept")
    unknown = find_frame(tree, "[unknown] libc.so.6")
    expect(unknown is not None, "unknown module frame missing")
    handle = find_frame(tree, "handle_request")
    parse = find_frame(tree, "parse_json")
    expect(handle is not None and parse is not None and parse in handle.children.values(), "stack was not reversed")

    filtered = load_perf_script(script, include_comm=False, comm_filter={"other"})
    expect(filtered.samples == 1, "comm filter failed")
    expect(find_frame(filtered, "other") is None, "--no-comm still inserted a comm frame")
    expect(find_frame(filtered, "clock_nanosleep") is not None, "filtered stack missing")

    folded = "python;main;malloc 3\npython;main;free 1\n# comment\n\nworker;loop 2.5\n"
    folded_tree = load_text(folded, "auto", include_comm=True, comm_filter=set())
    expect(detect_format(folded) == "folded", "folded file detected as script")
    expect(detect_format(script) == "script", "perf script detected as folded")
    expect(find_frame(folded_tree, "malloc").samples == 3, "folded count mismatch")
    expect(find_frame(folded_tree, "loop").samples == 2.5, "fractional folded count mismatch")

    boxes = layout(example_tree(), 1200, 0.25, icicle=False)
    by_name = {box.name: box for box in boxes}
    expect(by_name["index_scan"].width > by_name["deflate"].width, "wider stack is not wider on screen")
    expect(by_name["vfs_read"].y < by_name["read"].y, "callee should sit above its caller")
    icicle_boxes = {box.name: box for box in layout(example_tree(), 1200, 0.25, icicle=True)}
    expect(icicle_boxes["vfs_read"].y > icicle_boxes["read"].y, "icicle callee should sit below its caller")
    expect(color_for("malloc", "user") == color_for("malloc", "user"), "colors are not stable")
    expect(color_for("malloc", "user") != color_for("vfs_read", "kernel"), "kernel and user share a color")

    with tempfile.TemporaryDirectory() as temp_dir:
        path = os.path.join(temp_dir, "out.svg")
        root = example_tree()
        emit_quiet = os.path.abspath(path)
        boxes = layout(root, 1000, 0.25, False)
        write_svg(path, boxes, root.samples, "Example flame graph", 1000)
        import xml.etree.ElementTree as ET

        ET.parse(path)
        svg = open(path, encoding="utf-8").read()
        expect("index_scan" in svg and "init()" in svg and "Reset zoom" in svg, "svg is missing expected pieces")
        expect(os.path.exists(emit_quiet), "svg was not written")

    print(f"self-test ok ({checks} checks)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="flame",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Record a Linux perf profile and write an interactive flame graph SVG. "
            "You do not need flamegraph.pl. Open the SVG in a browser."
        ),
        epilog="""examples:
  flame check
  flame example -o example.svg --open
  flame run -o app.svg -- python3 app.py
  flame run -d 15 -F 99 -o app.svg -- python3 app.py
  flame attach -p 1234 -d 20 -o proc.svg
  flame system -d 10 -o system.svg
  flame graph -i perf.data -o out.svg
  perf script -i perf.data | flame graph -i - -o out.svg
  flame graph -i stacks.txt -o out.svg

folded stacks look like:  main;foo;bar 12
""",
    )
    view = argparse.ArgumentParser(add_help=False)
    view.add_argument("-o", "--output", default="flame.svg", help="SVG to write (default: flame.svg)")
    view.add_argument("--title", default="", help="Title drawn above the graph")
    view.add_argument("--width", type=int, default=1200, help="Image width in pixels (default: 1200)")
    view.add_argument("--min-width", type=float, default=0.25, help="Hide frames narrower than this many pixels")
    view.add_argument("--icicle", action="store_true", help="Put the root at the top instead of the bottom")
    view.add_argument("--open", action="store_true", help="Open the SVG in a browser when it is ready")

    filt = argparse.ArgumentParser(add_help=False)
    filt.add_argument("--no-comm", action="store_true", help="Do not add the process name at the base of each stack")
    filt.add_argument("--comm", action="append", default=[], help="Keep only this process name (repeatable)")

    record = argparse.ArgumentParser(add_help=False)
    record.add_argument("-F", "--freq", type=int, default=99, help="Samples per second (default: 99)")
    record.add_argument("--call-graph", choices=["fp", "dwarf", "lbr"], default="fp", help="Stack unwinder (default: fp)")
    record.add_argument("--keep", action="store_true", help="Also save perf.data next to the SVG")

    sub = parser.add_subparsers(dest="cmd", required=True)

    run = sub.add_parser("run", parents=[view, filt, record], help="Record a command and write a flame graph")
    run.add_argument("-d", "--duration", type=float, help="Stop recording after this many seconds")
    run.add_argument("command", nargs=argparse.REMAINDER, help="Command to record, after --")
    run.set_defaults(func=cmd_run)

    attach = sub.add_parser("attach", parents=[view, filt, record], help="Record a running process")
    attach.add_argument("-p", "--pid", type=int, required=True, help="Process id to record")
    attach.add_argument("-d", "--duration", type=float, default=10, help="Seconds to record (default: 10)")
    attach.set_defaults(func=cmd_attach)

    system = sub.add_parser("system", parents=[view, filt, record], help="Record every CPU")
    system.add_argument("-d", "--duration", type=float, default=10, help="Seconds to record (default: 10)")
    system.set_defaults(func=cmd_system)

    graph = sub.add_parser("graph", parents=[view, filt], help="Draw a flame graph from perf.data, perf script, or folded stacks")
    graph.add_argument("-i", "--input", default="perf.data", help="perf.data, a perf script dump, folded stacks, or - for stdin")
    graph.add_argument("--format", choices=["auto", "script", "folded"], default="auto")
    graph.set_defaults(func=cmd_graph)

    example = sub.add_parser("example", parents=[view], help="Write a sample flame graph, no perf required")
    example.set_defaults(func=cmd_example)

    check = sub.add_parser("check", help="Say whether this user can record with perf")
    check.set_defaults(func=cmd_check)

    test = sub.add_parser("self-test", help="Check the parser and SVG writer")
    test.set_defaults(func=cmd_selftest)
    return parser


def main(argv: list[str] | None = None) -> None:
    parser = build_parser()
    args = parser.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
