COMPRESSED = (
    (b"\x1f\x8b", "gzip"),
    (b"BZh", "bzip2"),
    (b"\xfd7zXZ\x00", "xz"),
    (b"\x28\xb5\x2f\xfd", "zstd"),
)


def open_compressed(path: str, kind: str):
    """A binary stream of a .gz, .bz2, .xz, or .zst file, or None for zstd without the module."""
    if kind == "gzip":
        import gzip

        return gzip.open(path, "rb")
    if kind == "bzip2":
        import bz2

        return bz2.open(path, "rb")
    if kind == "xz":
        import lzma

        return lzma.open(path, "rb")
    try:
        import zstandard  # type: ignore[import-not-found]

        return zstandard.ZstdDecompressor().stream_reader(open(path, "rb"), closefd=True)
    except ImportError:
        return None


_TEMP_DIRS: list[tempfile.TemporaryDirectory] = []


def temp_path(name: str) -> str:
    """A path in a directory that is removed when cpuflame exits."""
    holder = tempfile.TemporaryDirectory(prefix="cpuflame-")
    _TEMP_DIRS.append(holder)
    return os.path.join(holder.name, name)


def decompress_to(path: str, kind: str, out: str) -> None:
    stream = open_compressed(path, kind)
    if stream is None:
        if shutil.which("zstd") is None:
            raise SystemExit(f"{path} is zstd-compressed. Install zstd, or run: zstd -d {shlex.quote(path)}")
        with open(out, "wb") as handle:
            proc = subprocess.run(["zstd", "-dc", path], stdout=handle, stderr=subprocess.PIPE)
        if proc.returncode != 0:
            raise SystemExit(proc.stderr.decode(errors="replace").strip() or "zstd failed")
        return
    with stream, open(out, "wb") as handle:
        shutil.copyfileobj(stream, handle, 1 << 20)


def perf_script_of(path: str) -> InputFile:
    """Run perf script into a temporary file and read it from there."""
    require_perf()
    out = temp_path("perf.script")
    with open(out, "w", encoding="utf-8") as handle:
        script = subprocess.run(["perf", "script", "-i", path], stdout=handle, stderr=subprocess.PIPE, text=True)
    if script.returncode != 0 or os.path.getsize(out) == 0:
        raise SystemExit((script.stderr or "perf script failed").strip())
    return InputFile(out)


def read_graph_input(path: str):
    """The input as a str (stdin) or an InputFile read line by line."""
    if path == "-":
        return sys.stdin.read()
    if not os.path.exists(path):
        raise SystemExit(f"No such file: {path}\nRecord one with: cpuflame run -o cpuflame.svg -- your-command")
    with open(path, "rb") as handle:
        magic = handle.read(8)
    if magic.startswith(b"PERFILE"):
        return perf_script_of(path)
    for prefix, kind in COMPRESSED:
        if magic.startswith(prefix):
            plain = temp_path("input")
            decompress_to(path, kind, plain)
            with open(plain, "rb") as handle:
                if handle.read(8).startswith(b"PERFILE"):
                    return perf_script_of(plain)
            return InputFile(plain)
    return InputFile(path)


