    expect(recorded[recorded.index("--call-graph") + 1] == "fp", "attach capture is missing the call graph")
    expect("-g" not in recorded, "-g after --call-graph can override the unwinder")
    dwarf = record_command(99, "dwarf", "perf.data", "1", False, ["sleep", "1"])
    expect(dwarf[dwarf.index("--call-graph") + 1] == "dwarf,8192" and "-g" not in dwarf, "dwarf unwinder was not kept")
    expect("99" in recorded, "attach capture is missing -F 99")
    expect(is_lock("absl::lts_20230802::base_internal::SpinLock::SpinLoop()"), "abseil spin was missed")
    repeated = Node(Frame("all", "root"))
    add_sample(
        repeated,
        [Frame("app", "comm"), Frame("foo", "user"), Frame("bar", "user"), Frame("foo", "user")],
        10,
    )
    repeated_report = analyze(repeated, 8)
    foo_width = [samples for samples, name, _path in repeated_report.widest if name == "foo"]
    expect(foo_width == [10], "the same sample was counted twice in one function")
    many = Node(Frame("all", "root"))
    add_sample(many, [Frame("conn1", "comm"), Frame("work", "user")], 50)
    add_sample(many, [Frame("conn2", "comm"), Frame("work", "user")], 30)
    add_sample(many, [Frame("Checkpointer", "comm"), Frame("work", "user")], 20)
    grouped = analyze(many, 8)
    labels = [name for name, _samples in grouped.processes]
    expect(any(name.startswith("connections (2 threads)") for name in labels), "connection threads were not grouped")
    expect("conn1" not in labels and "conn2" not in labels, "individual connections were still listed")
    report_flags = build_parser().parse_args(["report", "-i", "stacks.txt", "--top", "3"])
    expect(report_flags.func == cmd_report and report_flags.top == 3, "report command")

    import io
    from contextlib import redirect_stdout

    with tempfile.TemporaryDirectory() as temp_dir:
        svg = os.path.join(temp_dir, "example.svg")
        with redirect_stdout(io.StringIO()):
            main(["example", "-o", svg])
        report_path = os.path.join(temp_dir, "example.txt")
        expect(os.path.exists(svg), "example svg missing")
        expect(os.path.exists(report_path), "example report missing")
        expect(open(report_path, encoding="utf-8").read() == EXAMPLE_REPORT, "example file is not the golden report")
        svg_only = os.path.join(temp_dir, "quiet.svg")
        with redirect_stdout(io.StringIO()):
            main(["example", "-o", svg_only, "--no-report"])
        expect(not os.path.exists(os.path.join(temp_dir, "quiet.txt")), "--no-report still wrote a report")
        folded = os.path.join(temp_dir, "stacks.txt")
        out = os.path.join(temp_dir, "out.txt")
        with open(folded, "w", encoding="utf-8") as handle:
            handle.write("main;foo;bar 12\n")
        with redirect_stdout(io.StringIO()):
            main(["report", "-i", folded, "-o", out])
        written = open(out, encoding="utf-8").read()
        expect("bar is 100.0% of self time" in written, "report command missed the leaf")
        expect(find_frame(load_folded("main;foo;bar 12\n", set(), True), "main").frame.kind == "user", "report input recolored main")

    # perf script headers: padded comm, comm with spaces, hex-looking comm, period column.
    padded = (
        "         cc1  4242 [001] 20.000000:     1000 cycles:P: \n"
        "\tffffffffc0a1b2c3 xfs_buf_find+0x10 ([xfs])\n"
        "\tffffffff81001234 [unknown] ([unknown])\n"
        "\t7ff1 main+0x5 (/usr/bin/cc1)\n"
        "\n"
        "GC Thread#0 77/78 [002] 20.100000:     3000 cycles:P: \n"
        "\t7ff1 work+0x5 (/usr/lib/jvm/libjvm.so)\n"
        "\n"
    )
    headed = load_perf_script(padded, include_comm=True, comm_filter=set())
    expect(find_frame(headed, "cc1") is not None and find_frame(headed, "cc1").frame.kind == "comm", "padded hex comm read as a frame")
    expect(find_frame(headed, "GC Thread#0") is not None, "comm with a space was cut at the space")
    expect(headed.samples == 4000 and (headed.meta or {}).get("weight") == "period", "period weighting was not used")
    expect(find_frame(headed, "xfs_buf_find").frame.kind == "kernel", "kernel module frame was drawn as user code")
    expect(find_frame(headed, "[unknown] [unknown]").frame.kind == "kernel", "kernel address was drawn as user code")
    counted = load_perf_script(padded, include_comm=True, comm_filter=set(), weight="samples")
    expect(counted.samples == 2, "--weight samples did not count samples")

    # perf's own re-arm (period 1) must not look like a kernel problem.
    msr_script = ""
    for index in range(60):
        msr_script += (
            f"conn{index % 3} 10 {30 + index / 100:.6f}:          1 cycles:P: \n"
            "\tffffffff81000001 native_write_msr+0x6 ([kernel.kallsyms])\n"
            "\tffffffff81000002 intel_pmu_enable_all+0x15 ([kernel.kallsyms])\n"
            "\t7ff1 start_thread+0x1 (/usr/lib64/libc.so.6)\n\n"
            f"conn{index % 3} 10 {30 + index / 100 + 0.001:.6f}:    1000000 cycles:P: \n"
            "\t7ff1 do_query+0x6 (/usr/bin/app)\n"
            "\t7ff1 start_thread+0x1 (/usr/lib64/libc.so.6)\n\n"
        )
    msr_tree = load_perf_script(msr_script, include_comm=True, comm_filter=set())
    msr_report = render_report(analyze(msr_tree, 8))
    expect("do_query is 100.0% of self time" in msr_report, "period weighting did not shrink perf overhead")
    expect("kernel time is" not in msr_report, "perf overhead became a kernel finding")
    expect("connections (3 threads)" in msr_report, "merged connection threads lost their count")
    expect(find_frame(msr_tree, "conn*") is not None, "numbered threads were not merged")
    by_count = render_report(analyze(load_perf_script(msr_script, True, set(), weight="samples"), 8))
    expect("perf overhead is 50.0%" in by_count, "sample weighting did not flag perf overhead")
    split = load_perf_script(msr_script, True, set(), per_thread=True)
    expect(find_frame(split, "conn1") is not None and find_frame(split, "conn*") is None, "--per-thread merged threads")
    lone = load_perf_script("worker1 1 [000] 1.000000: 5 cycles:\n\t7ff1 f+0x1 (/bin/a)\n", True, set())
    expect(find_frame(lone, "worker1") is not None, "a single numbered thread was renamed")

    # stackcollapse-perf output with no _[k] marks: comm first, [module] for unnamed frames.
    collapsed = load_folded("conn12;[libpthread-2.28.so];[mongod];[[kernel.kallsyms]] 5\nconn13;[mongod] 20\n", set(), True)
    expect(find_frame(collapsed, "conn*") is not None, "collapsed comm frame was not a process")
    expect(find_frame(collapsed, "[unknown] mongod") is not None, "[mongod] was not read as an unnamed frame")
    expect(find_frame(collapsed, "[unknown] [kernel.kallsyms]").frame.kind == "kernel", "[[kernel.kallsyms]] was not kernel")
    collapsed_report = render_report(analyze(collapsed, 8))
    expect("symbols are missing for mongod" in collapsed_report, "unnamed collapsed stacks were not flagged")
    expect("optimize [mongod]" not in collapsed_report and "repeats" not in collapsed_report, "unnamed frames read as code")

    # Unnamed static functions inside a named caller belong to that caller.
    owned = stacked([
        ([comm("conn*"), user("start_thread"), user("handle"), user("operator delete(void*)"),
          user("tcmalloc::CpuCache::Deallocate"), user("[unknown] app"), user("absl::base_internal::SpinLock::SpinLoop()")], 30),
        ([comm("conn*"), user("start_thread"), user("handle"), user("operator new(unsigned long)"),
          user("tcmalloc::CpuCache::Refill"), user("[unknown] app")], 30),
        ([comm("conn*"), user("start_thread"), user("handle"), user("scan")], 40),
    ])
    expect("symbols are missing" not in owned, "unnamed code under a named caller was called missing symbols")
    expect("[unknown] in tcmalloc::CpuCache::Refill" in owned, "unnamed self time was not given its caller")
    expect("memory allocation (tcmalloc) is 60.0% of inclusive time" in owned, "allocator inclusive time missed")
    expect("lock contention inside tcmalloc" in owned, "allocator lock spin was not explained")
    expect("the CPU is spinning in" not in owned, "allocator spin was also reported as an application lock")
    expect("The caller is [unknown]" not in owned, "caller pointed at an unnamed frame")

    import gzip as _gzip

    with tempfile.TemporaryDirectory() as temp_dir:
        packed = os.path.join(temp_dir, "perf.script.gz")
        with _gzip.open(packed, "wt", encoding="utf-8") as handle:
            handle.write(script)
        expect(any("decode_utf8" in line for line in lines_of(read_graph_input(packed))), "gzip input was not read")
        packed_tree = load_text(read_graph_input(packed), "auto", True, set())
        expect(find_frame(packed_tree, "decode_utf8") is not None, "gzip perf script was not parsed")

    # MongoDB: a $lookup stage that drives most allocation is reported first, as the cause.
    lookup = stacked([
        ([comm("conn*"), user("mongo::Pipeline::getNext()"), user("mongo::DocumentSourceLookUp::doGetNext()"),
          user("mongo::DocumentSourceLookUp::buildPipeline<false>()"), user("operator new(unsigned long)"),
          user("tcmalloc::CpuCache::Refill(int)"), user("absl::base_internal::SpinLock::SpinLoop()")], 50),
        ([comm("conn*"), user("mongo::Pipeline::getNext()"), user("mongo::DocumentSourceLookUp::doGetNext()"),
          user("mongo::DocumentSourceLookUp::buildPipeline<false>()"), user("mongo::Pipeline::makePipeline()")], 20),
        ([comm("conn*"), user("mongo::Pipeline::getNext()"), user("mongo::other()")], 30),
    ])
    first = lookup.split("Findings\n", 1)[1].splitlines()[0]
    expect(first.startswith("1. the $lookup stage is 70.0%"), "the $lookup cause was not listed first: " + first)
    expect("100% of all allocator time" in lookup and "building the inner pipeline" in lookup, "$lookup evidence missing")
    expect("the lock is reached from the per-CPU cache slow path: tcmalloc::CpuCache::Refill(int)" in lookup, "slow path owner missing")
    expect("Where the work narrows" in lookup, "work focus line missing")
    expect(is_action("cut the allocation rate.") and not is_action("24.8% is lock contention inside tcmalloc"), "action split")
    expect(sentence_case("mongod uses x") == "mongod uses x" and sentence_case("cut it") == "Cut it", "sentence case")

    page = render_html(analyze(example_tree(), 8), "<svg data-plot-width=\"1\"></svg>\n")
    expect("Findings" in page and "memcmp" in page and "<svg" in page, "html report is missing the graph or the finding")
    expect("Diagnosis" in page and "Action plan" in page and "Read with care" in page, "html report is missing the conclusion")
    expect('data-highlight="memcmp"' in page, "finding card cannot highlight its frame")
    expect("http://" not in page.replace("http://www.w3.org/2000/svg", "") and "https://" not in page, "html report loads from the network")

    print(f"self-test ok ({checks} checks)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="cpuflame",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Record a Linux perf profile, write an interactive flame graph SVG, "
            "and a short report of the hot frames. You do not need flamegraph.pl."
        ),
        epilog="""examples:
  cpuflame check
  binary_to_monitor=mysqld
  cpuflame attach --binary "$binary_to_monitor" -d 60 -o flamegraph.svg
  sudo perf record -a -g -F99 -p $(pgrep -x "$binary_to_monitor") -- sleep 60
  sudo perf script > perf.script
  cpuflame graph -i perf.script -o flamegraph.svg
  cpuflame report -i perf.script -o flamegraph.txt
  cpuflame html -i perf.script -o flamegraph.html

folded stacks look like:  main;foo;bar 12
""",
    )
    view = argparse.ArgumentParser(add_help=False)
    view.add_argument("-o", "--output", default="cpuflame.svg", help="SVG to write (default: cpuflame.svg)")
    view.add_argument("--title", default="", help="Title drawn above the graph")
    view.add_argument("--width", type=int, default=1200, help="Image width in pixels (default: 1200)")
    view.add_argument("--min-width", type=float, default=0.25, help="Hide frames narrower than this many pixels")
    view.add_argument("--icicle", action="store_true", help="Put the root at the top instead of the bottom")
    view.add_argument("--open", action="store_true", help="Open the SVG in a browser when it is ready")

    filt = argparse.ArgumentParser(add_help=False)
    filt.add_argument("--no-comm", action="store_true", help="Do not add the process name at the base of each stack")
    filt.add_argument("--comm", action="append", default=[], help="Keep only this process name (repeatable)")
    filt.add_argument(
        "--weight",
        choices=["auto", "period", "samples"],
        default="auto",
        help="perf script input: weight each sample by its event count (period, what perf report uses) "
        "or count every sample as 1. auto uses period when every sample has one (default: auto)",
    )
    filt.add_argument(
        "--per-thread",
        action="store_true",
        help="Keep numbered threads apart (conn1, conn2). By default they merge into conn* so the same code path is one tower",
    )

    record = argparse.ArgumentParser(add_help=False)
    record.add_argument("-F", "--freq", type=int, default=99, help="Samples per second (default: 99)")
    record.add_argument("--call-graph", choices=["fp", "dwarf", "lbr"], default="fp", help="Stack unwinder (default: fp)")
    record.add_argument("--keep", action="store_true", help="Also save perf.data next to the SVG")
    record.add_argument(
        "--record-only",
        action="store_true",
        help="Save perf.data and stop. Implies --keep. No SVG and no report",
    )

    words = argparse.ArgumentParser(add_help=False)
    words.add_argument("--report", default="", help="Write the report here. Default: the SVG path with .txt")
    words.add_argument("--no-report", action="store_true", help="Do not write the report")
    words.add_argument("--top", type=int, default=8, help="Rows in the widest and self-time lists (default: 8)")

    sub = parser.add_subparsers(dest="cmd", required=True)

    run = sub.add_parser("run", parents=[view, filt, record, words], help="Record a command, write a flame graph, and write a report")
    run.add_argument("-d", "--duration", type=float, help="Stop recording after this many seconds")
    run.add_argument("command", nargs=argparse.REMAINDER, help="Command to record, after --")
    run.set_defaults(func=cmd_run)

    attach = sub.add_parser("attach", parents=[view, filt, record, words], help="Record a running process on all CPUs")
    target = attach.add_mutually_exclusive_group(required=True)
    target.add_argument("-p", "--pid", type=int, help="Process id to record")
    target.add_argument("--binary", help="Process name, matched exactly (pgrep -x). Example: mysqld, mongod")
    attach.add_argument("-d", "--duration", type=float, default=60, help="Seconds to record (default: 60)")
    attach.set_defaults(func=cmd_attach)

    system = sub.add_parser("system", parents=[view, filt, record, words], help="Record every CPU")
    system.add_argument("-d", "--duration", type=float, default=10, help="Seconds to record (default: 10)")
    system.set_defaults(func=cmd_system)

    graph = sub.add_parser("graph", parents=[view, filt], help="Draw a flame graph from perf.data, perf script, or folded stacks")
    graph.add_argument("-i", "--input", default="perf.data", help="perf.data, a perf script dump, folded stacks, or - for stdin")
    graph.add_argument("--format", choices=["auto", "script", "folded"], default="auto")
    graph.set_defaults(func=cmd_graph)

    example = sub.add_parser("example", parents=[view, words], help="Write a sample flame graph and report, no perf required")
    example.set_defaults(func=cmd_example)

    html = sub.add_parser("html", parents=[filt], help="Write an HTML report with the graph and the findings")
    html.add_argument("-i", "--input", default="perf.data", help="perf.data, a perf script dump, folded stacks, or - for stdin")
    html.add_argument("--format", choices=["auto", "script", "folded"], default="auto")
    html.add_argument("-o", "--output", default="flamegraph.html", help="HTML file to write (default: flamegraph.html)")
    html.add_argument("--title", default="", help="Title drawn above the graph")
    html.add_argument("--width", type=int, default=1200, help="Image width in pixels (default: 1200)")
    html.add_argument("--min-width", type=float, default=0.25, help="Hide frames narrower than this many pixels")
    html.add_argument("--icicle", action="store_true", help="Put the root at the top instead of the bottom")
    html.add_argument("--top", type=int, default=8, help="Rows in the widest and self-time lists (default: 8)")
    html.set_defaults(func=cmd_html)

    report = sub.add_parser("report", parents=[filt], help="Write the performance report, no SVG")
    report.add_argument("-i", "--input", default="perf.data", help="perf.data, a perf script dump, folded stacks, or - for stdin")
    report.add_argument("--format", choices=["auto", "script", "folded"], default="auto")
    report.add_argument("-o", "--output", default="", help="Also write the report to this file")
    report.add_argument("--top", type=int, default=8, help="Rows in the widest and self-time lists (default: 8)")
    report.set_defaults(func=cmd_report)

    check = sub.add_parser("check", help="Say whether this user can record with perf")
    check.set_defaults(func=cmd_check)

    test = sub.add_parser("self-test", help="Check the parser and SVG writer")
    test.set_defaults(func=cmd_selftest)
    return parser


def main(argv: list[str] | None = None) -> None:
    parser = build_parser()
    args = parser.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
