@dataclass(frozen=True)
class Frame:
    name: str
    kind: str


class Node:
    __slots__ = ("frame", "samples", "children", "meta")

    def __init__(self, frame: Frame):
        self.frame = frame
        self.samples = 0
        self.children: dict[Frame, Node] = {}
        # Only the root uses meta: sample count, weighting, merged thread counts.
        self.meta: dict | None = None

    def child(self, frame: Frame) -> Node:
        node = self.children.get(frame)
        if node is None:
            node = Node(frame)
            self.children[frame] = node
        return node

    def self_samples(self) -> float:
        return self.samples - sum(child.samples for child in self.children.values())


@dataclass
class Box:
    id: str
    name: str
    kind: str
    samples: float
    self_samples: float
    parent_samples: float
    depth: int
    x: float
    y: float
    width: float


def clean_name(name: str) -> str:
    name = " ".join(name.split())
    if len(name) > 400:
        name = name[:397] + "..."
    return name or "[unnamed]"


def is_kernel_module(module: str, address: int | None) -> bool:
    """[kernel.kallsyms], a loadable module such as [xfs], or a kernel address."""
    if "kernel" in module.lower():
        return True
    if module.startswith("[") and module.endswith("]") and module not in USER_PSEUDO_MODULES:
        return True
    return address is not None and address >= KERNEL_ADDR


def tidy(symbol: str, module: str, address: int | None = None) -> Frame:
    symbol = symbol.strip()
    module = module.strip()
    if module == "inline":
        symbol = f"{symbol} [inline]"
        module = ""
    symbol = OFFSET_RE.sub("", symbol).strip()
    kind = "kernel" if is_kernel_module(module, address) else "user"
    if symbol in ("[unknown]", ""):
        base = module.rsplit("/", 1)[-1] if module else "unknown"
        symbol = f"[unknown] {base}"
    return Frame(clean_name(symbol), kind)


def frame_address(line: str) -> int | None:
    match = ADDR_RE.match(line)
    if not match:
        return None
    try:
        return int(match.group(1), 16)
    except ValueError:
        return None


_FRAME_CACHE: dict[tuple[str, bool], Frame] = {}


def parse_frame(line: str) -> Frame:
    """Parse one stack line. The text after the address repeats a lot, so it is cached."""
    address = frame_address(line)
    match = ADDR_RE.match(line)
    rest = line[match.end():] if match else line
    key = (rest, address is not None and address >= KERNEL_ADDR)
    frame = _FRAME_CACHE.get(key)
    if frame is None:
        frame = _parse_frame(line, address)
        if len(_FRAME_CACHE) < 2_000_000:
            _FRAME_CACHE[key] = frame
    return frame


def _parse_frame(line: str, address: int | None) -> Frame:
    match = MODULE_RE.match(line)
    if match:
        return tidy(match.group(1), match.group(2), address)
    match = PLAIN_RE.match(line)
    if match:
        return tidy(match.group(1), "", address)
    return Frame("[unparsed]", "user")


class InputFile:
    """A text input read line by line from disk, so a 1 GB perf script is never held in memory."""

    def __init__(self, path: str):
        self.path = path

    def lines(self):
        with open(self.path, encoding="utf-8", errors="replace", newline="") as handle:
            for line in handle:
                yield line.rstrip("\r\n")

    def read(self) -> str:
        with open(self.path, encoding="utf-8", errors="replace") as handle:
            return handle.read()


def lines_of(text) -> "typing.Iterator[str]":
    """Lines of a str or an InputFile, without line endings."""
    if isinstance(text, InputFile):
        return text.lines()
    return iter(text.splitlines())


@dataclass
class Header:
    comm: str
    period: int | None
    event: str


def parse_header(line: str) -> Header | None:
    """Read a perf script sample header. None when the line is not one."""
    match = HEADER_RE.match(line)
    if not match:
        if not TS_RE.search(line) or FRAME_RE.match(line):
            return None
        parts = line.split()
        return Header(parts[0] if parts else "?", None, "")
    rest = match.group("rest").split()
    period: int | None = None
    event = ""
    if len(rest) >= 2 and rest[0].isdigit():
        period = int(rest[0])
        event = rest[1]
    elif rest:
        event = rest[0]
    return Header(match.group("comm").strip(), period, event.rstrip(":"))


def parse_comm(line: str) -> str:
    header = parse_header(line)
    if header is not None:
        return header.comm
    parts = line.split()
    return parts[0] if parts else "?"


def thread_base(comm: str) -> str | None:
    """conn1234 -> conn*, swapper/3 -> swapper/*. None when there is no trailing number."""
    match = THREAD_NUM_RE.match(comm)
    if not match or not match.group("base").strip():
        return None
    return match.group("base") + "*"


def thread_merge_map(comms) -> tuple[dict[str, str], dict[str, int]]:
    """Merge numbered threads (conn1, conn2, ...) when at least two share a base name."""
    members: dict[str, set[str]] = {}
    for comm in comms:
        base = thread_base(comm)
        if base is not None:
            members.setdefault(base, set()).add(comm)
    mapping: dict[str, str] = {}
    counts: dict[str, int] = {}
    for base, names in members.items():
        if len(names) < 2:
            continue
        counts[base] = len(names)
        for name in names:
            mapping[name] = base
    return mapping, counts


def scan_headers(text) -> tuple[set[str], bool, list[str]]:
    """First pass over perf script text: thread names, whether every header has a period, events."""
    comms: set[str] = set()
    events: set[str] = set()
    every_period = True
    seen = False
    for line in lines_of(text):
        if not line or line.startswith("#") or line[:1] == "\t":
            continue
        if not TS_RE.search(line):
            continue
        header = parse_header(line)
        if header is None:
            continue
        seen = True
        comms.add(header.comm)
        if header.event:
            events.add(header.event)
        if header.period is None:
            every_period = False
    return comms, seen and every_period, sorted(events)


def add_sample(root: Node, frames: list[Frame], weight: float) -> None:
    root.samples += weight
    node = root
    for frame in frames:
        node = node.child(frame)
        node.samples += weight


def load_perf_script(
    text,
    include_comm: bool,
    comm_filter: set[str],
    weight: str = "auto",
    per_thread: bool = False,
) -> Node:
    """Build the stack tree from perf script text.

    weight: "period" uses the event count perf printed on each header (what perf report
    uses), "samples" counts every sample as 1, "auto" picks period when every header has one.
    With -F frequency sampling the first samples after a context switch carry a period
    of 1 and land in perf's own code (native_write_msr). Counting them as 1 each
    makes perf look like a large share of the profile.
    """
    if weight not in ("auto", "period", "samples"):
        raise SystemExit("--weight must be auto, period, or samples")
    root = Node(Frame("all", "root"))
    comms, has_period, events = scan_headers(text)
    if weight == "period" and not has_period:
        raise SystemExit(
            "--weight period needs a period on every sample header. "
            "Re-run perf script without -F, or use --weight samples."
        )
    use_period = has_period and weight in ("auto", "period")
    mapping, thread_counts = ({}, {}) if per_thread else thread_merge_map(comms)
    current: Header | None = None
    leaf_first: list[Frame] = []
    saw_header = False
    count = 0

    def flush() -> None:
        nonlocal current, leaf_first, count
        if current is None:
            return
        header = current
        frames = leaf_first
        current = None
        leaf_first = []
        comm = header.comm
        if comm_filter and comm not in comm_filter and mapping.get(comm, comm) not in comm_filter:
            return
        stack = list(reversed(frames))
        if not stack:
            stack = [Frame("[no stack]", "user")]
        if include_comm:
            stack = [Frame(clean_name(mapping.get(comm, comm)), "comm")] + stack
        count += 1
        add_sample(root, stack, (header.period or 0) if use_period else 1)

    for line in lines_of(text):
        if not line.strip() or line.startswith("#"):
            if not line.strip() and current is not None:
                flush()
            continue
        if not line.startswith("\t") and TS_RE.search(line):
            header = parse_header(line)
            if header is not None:
                flush()
                saw_header = True
                current = header
                leaf_first = []
                continue
        if FRAME_RE.match(line):
            if current is None:
                current = Header("?", None, "")
            leaf_first.append(parse_frame(line))
            continue
    flush()
    root.meta = {
        "sample_count": count,
        "weight": "period" if use_period else "samples",
        "events": events,
        "threads": thread_counts if include_comm else {},
    }

    if root.samples == 0 and count and use_period:
        raise SystemExit("Every sample has a period of 0. Use --weight samples.")
    if root.samples == 0:
        if comm_filter and saw_header:
            raise SystemExit(
                "No samples matched --comm. "
                "The filter is the process name from the perf script header (the first field)."
            )
        raise SystemExit(
            "No samples found. Expected `perf script` output: a header line, then indented stack frames."
        )
    return root


def split_folded_name(name: str) -> tuple[str, str | None]:
    match = MARK_RE.search(name.strip())
    if not match:
        return name.strip(), None
    return name[: match.start()].strip(), match.group(1)


def folded_has_marks(text) -> bool:
    """True when the file uses stackcollapse suffixes such as _[k]."""
    for line in lines_of(text):
        if not line.strip() or line.startswith("#"):
            continue
        match = FOLDED_RE.match(line)
        if not match:
            continue
        for part in match.group(1).split(";"):
            if part.strip() and split_folded_name(part)[1]:
                return True
    return False


def folded_is_collapsed(text) -> bool:
    """stackcollapse-perf output without _[k] marks: frames such as [mongod] or [[kernel.kallsyms]]."""
    checked = 0
    for line in lines_of(text):
        if not line.strip() or line.startswith("#"):
            continue
        match = FOLDED_RE.match(line)
        if not match:
            continue
        checked += 1
        for part in match.group(1).split(";")[1:]:
            part = part.strip()
            if BRACKET_MODULE_RE.match(part) and part != "[unknown]":
                return True
        if checked >= 2000:
            break
    return False


def folded_frame(part: str, mark: str | None, collapsed: bool) -> Frame:
    base = clean_name(part)
    if collapsed:
        bracket = BRACKET_MODULE_RE.match(base)
        if bracket and base != "[unknown]":
            module = bracket.group("module")
            kind = "kernel" if is_kernel_module(module, None) or module.startswith("[kernel") else "user"
            module = module.strip("[]")
            if module == "kernel.kallsyms":
                module = "[kernel.kallsyms]"
                kind = "kernel"
            return Frame(f"[unknown] {module}", kind)
    if mark == "k":
        return Frame(base, "kernel")
    return Frame(base, "user")


def load_folded(text, comm_filter: set[str], include_comm: bool = True, per_thread: bool = False) -> Node:
    root = Node(Frame("all", "root"))
    skipped = 0
    count = 0
    # Plain folded input (main;foo;bar 12) stays all user frames.
    # stackcollapse-perf.pl puts the process name first. It marks kernel frames with _[k]
    # when asked, and writes [module] when a frame has no symbol.
    marked = folded_has_marks(text)
    collapsed = marked or folded_is_collapsed(text)
    rows: list[tuple[list[str], str]] = []
    for line in lines_of(text):
        if not line.strip() or line.startswith("#"):
            continue
        match = FOLDED_RE.match(line)
        if not match:
            skipped += 1
            continue
        raw_parts = [part.strip() for part in match.group(1).split(";") if part.strip()]
        if not raw_parts:
            skipped += 1
            continue
        rows.append((raw_parts, match.group(2)))
    mapping: dict[str, str] = {}
    thread_counts: dict[str, int] = {}
    if collapsed and not per_thread:
        mapping, thread_counts = thread_merge_map({parts[0] for parts, _weight in rows})
    for raw_parts, raw_weight in rows:
        frames: list[Frame] = []
        comm_name = raw_parts[0] if collapsed else None
        if comm_filter:
            first = comm_name if comm_name is not None else raw_parts[0]
            if first not in comm_filter and mapping.get(first, first) not in comm_filter:
                continue
        for index, part in enumerate(raw_parts):
            base, mark = split_folded_name(part) if marked else (part, None)
            base = clean_name(base)
            if not base:
                continue
            if collapsed and index == 0 and mark != "k":
                if include_comm:
                    frames.append(Frame(clean_name(mapping.get(base, base)), "comm"))
                continue
            frames.append(folded_frame(base, mark, collapsed))
        if not frames:
            skipped += 1
            continue
        weight = float(raw_weight) if "." in raw_weight else int(raw_weight)
        count += 1
        add_sample(root, frames, weight)
    root.meta = {
        "sample_count": count,
        "weight": "folded",
        "events": [],
        "threads": thread_counts if include_comm else {},
    }
    if root.samples == 0:
        if comm_filter:
            raise SystemExit("No folded stacks matched --comm. For folded input the first frame is the process name.")
        if skipped:
            raise SystemExit("No folded stacks found. Expected lines like: main;foo;bar 12")
        raise SystemExit("No samples found.")
    return root


def detect_format(text) -> str:
    checked = 0
    for line in lines_of(text):
        if not line.strip() or line.startswith("#"):
            continue
        checked += 1
        if FRAME_RE.match(line) or TS_RE.search(line):
            return "script"
        if checked >= 40:
            break
    return "folded"


def load_text(
    text,
    fmt: str,
    include_comm: bool,
    comm_filter: set[str],
    weight: str = "auto",
    per_thread: bool = False,
) -> Node:
    kind = detect_format(text) if fmt == "auto" else fmt
    if kind != "script" and weight == "period":
        print("Folded stacks carry their own counts. --weight period is ignored.", file=sys.stderr)
    if kind == "script":
        return load_perf_script(text, include_comm, comm_filter, weight=weight, per_thread=per_thread)
    return load_folded(text, comm_filter, include_comm, per_thread=per_thread)


