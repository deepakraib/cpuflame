@dataclass(frozen=True)
class Frame:
    name: str
    kind: str


class Node:
    def __init__(self, frame: Frame):
        self.frame = frame
        self.samples = 0
        self.children: dict[Frame, Node] = {}

    def child(self, frame: Frame) -> Node:
        node = self.children.get(frame)
        if node is None:
            node = Node(frame)
            self.children[frame] = node
        return node

    def self_samples(self) -> float:
        return self.samples - sum(child.samples for child in self.children.values())


@dataclass
class Box:
    id: str
    name: str
    kind: str
    samples: float
    self_samples: float
    parent_samples: float
    depth: int
    x: float
    y: float
    width: float


def clean_name(name: str) -> str:
    name = " ".join(name.split())
    if len(name) > 400:
        name = name[:397] + "..."
    return name or "[unnamed]"


def tidy(symbol: str, module: str) -> Frame:
    symbol = symbol.strip()
    module = module.strip()
    if module == "inline":
        symbol = f"{symbol} [inline]"
        module = ""
    symbol = OFFSET_RE.sub("", symbol).strip()
    kind = "kernel" if "kernel" in module.lower() else "user"
    if symbol in ("[unknown]", ""):
        base = module.rsplit("/", 1)[-1] if module else "unknown"
        symbol = f"[unknown] {base}"
    return Frame(clean_name(symbol), kind)


def parse_frame(line: str) -> Frame:
    match = MODULE_RE.match(line)
    if match:
        return tidy(match.group(1), match.group(2))
    match = PLAIN_RE.match(line)
    if match:
        return tidy(match.group(1), "")
    return Frame("[unparsed]", "user")


def parse_comm(line: str) -> str:
    parts = line.split()
    return parts[0] if parts else "?"


def add_sample(root: Node, frames: list[Frame], weight: float) -> None:
    root.samples += weight
    node = root
    for frame in frames:
        node = node.child(frame)
        node.samples += weight


def load_perf_script(text: str, include_comm: bool, comm_filter: set[str]) -> Node:
    root = Node(Frame("all", "root"))
    current_comm: str | None = None
    leaf_first: list[Frame] = []
    saw_header = False

    def flush() -> None:
        nonlocal current_comm, leaf_first
        if current_comm is None:
            return
        comm = current_comm
        frames = leaf_first
        current_comm = None
        leaf_first = []
        if comm_filter and comm not in comm_filter:
            return
        stack = list(reversed(frames))
        if not stack:
            stack = [Frame("[no stack]", "user")]
        if include_comm:
            stack = [Frame(clean_name(comm), "comm")] + stack
        add_sample(root, stack, 1)

    for line in text.splitlines():
        if not line.strip() or line.startswith("#"):
            if not line.strip() and current_comm is not None:
                flush()
            continue
        if FRAME_RE.match(line):
            if current_comm is None:
                current_comm = "?"
            leaf_first.append(parse_frame(line))
            continue
        if TS_RE.search(line):
            flush()
            saw_header = True
            current_comm = parse_comm(line)
            leaf_first = []
            continue
    flush()

    if root.samples == 0:
        if comm_filter and saw_header:
            raise SystemExit(
                "No samples matched --comm. "
                "The filter is the process name from the perf script header (the first field)."
            )
        raise SystemExit(
            "No samples found. Expected `perf script` output: a header line, then indented stack frames."
        )
    return root


def split_folded_name(name: str) -> tuple[str, str | None]:
    match = MARK_RE.search(name.strip())
    if not match:
        return name.strip(), None
    return name[: match.start()].strip(), match.group(1)


def folded_has_marks(text: str) -> bool:
    """True when the file uses stackcollapse suffixes such as _[k]."""
    for line in text.splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        match = FOLDED_RE.match(line)
        if not match:
            continue
        for part in match.group(1).split(";"):
            if part.strip() and split_folded_name(part)[1]:
                return True
    return False


def load_folded(text: str, comm_filter: set[str], include_comm: bool = True) -> Node:
    root = Node(Frame("all", "root"))
    skipped = 0
    # Plain folded input (main;foo;bar 12) stays all user frames.
    # stackcollapse-perf.pl marks kernel frames and puts the process name first.
    marked = folded_has_marks(text)
    for line in text.splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        match = FOLDED_RE.match(line)
        if not match:
            skipped += 1
            continue
        raw_parts = [part.strip() for part in match.group(1).split(";") if part.strip()]
        frames: list[Frame] = []
        for index, part in enumerate(raw_parts):
            base, mark = split_folded_name(part) if marked else (part, None)
            base = clean_name(base)
            if not base:
                continue
            if marked and index == 0 and include_comm and mark != "k":
                kind = "comm"
            elif mark == "k":
                kind = "kernel"
            else:
                kind = "user"
            frames.append(Frame(base, kind))
        if not frames:
            skipped += 1
            continue
        if comm_filter and frames[0].name not in comm_filter:
            continue
        weight = float(match.group(2)) if "." in match.group(2) else int(match.group(2))
        add_sample(root, frames, weight)
    if root.samples == 0:
        if comm_filter:
            raise SystemExit("No folded stacks matched --comm. For folded input the first frame is the process name.")
        if skipped:
            raise SystemExit("No folded stacks found. Expected lines like: main;foo;bar 12")
        raise SystemExit("No samples found.")
    return root


def detect_format(text: str) -> str:
    checked = 0
    for line in text.splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        checked += 1
        if FRAME_RE.match(line) or TS_RE.search(line):
            return "script"
        if checked >= 40:
            break
    return "folded"


def load_text(text: str, fmt: str, include_comm: bool, comm_filter: set[str]) -> Node:
    kind = detect_format(text) if fmt == "auto" else fmt
    if kind == "script":
        return load_perf_script(text, include_comm, comm_filter)
    return load_folded(text, comm_filter, include_comm)


