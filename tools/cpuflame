FRAME_RE = re.compile(r"^\s+[0-9a-fA-F]+\s+\S")
MODULE_RE = re.compile(r"^\s+[0-9a-fA-F]+\s+(.*)\s+\(([^()]*)\)\s*$")
PLAIN_RE = re.compile(r"^\s+[0-9a-fA-F]+\s+(\S.*?)\s*$")
OFFSET_RE = re.compile(r"\+0x[0-9a-fA-F]+(?:/0x[0-9a-fA-F]+)?$")
TS_RE = re.compile(r"(?:^|\s)\d+\.\d+:")
FOLDED_RE = re.compile(r"^(.*\S)\s+([0-9]+(?:\.[0-9]+)?)\s*$")
MARK_RE = re.compile(r"_(?: )?\[([kuij])\]$")
CLONE_RE = re.compile(r"\.(?:constprop|isra|part|cold)(?:\.\d+)?$")
# perf script sample header: comm (may contain spaces), pid[/tid], optional [cpu], time:, optional period, event.
HEADER_RE = re.compile(
    r"^\s*(?P<comm>\S.*?)\s+(?P<pid>-?\d+)(?:/(?P<tid>-?\d+))?\s+(?:\[(?P<cpu>\d+)\]\s+)?"
    r"(?P<time>\d+\.\d+):\s*(?P<rest>.*)$"
)
ADDR_RE = re.compile(r"^\s+([0-9a-fA-F]+)\s")
# Frames under this address are user space on x86_64 and arm64. Kernel text and modules sit above it.
KERNEL_ADDR = 0xFFFF800000000000
USER_PSEUDO_MODULES = frozenset({"[vdso]", "[vsyscall]", "[vectors]", "[unknown]", "[heap]", "[stack]", "[anon]", "[jit]"})
THREAD_NUM_RE = re.compile(r"^(?P<base>.*\D)\d+$")
BRACKET_MODULE_RE = re.compile(r"^\[(?P<module>[^\[\]]+|\[kernel\.kallsyms\])\]$")

