@functools.lru_cache(maxsize=None)
def strip_symbol(symbol: str) -> str:
    text = symbol.strip()
    while True:
        nxt = CLONE_RE.sub("", text)
        if nxt.endswith("@plt"):
            nxt = nxt[: -len("@plt")]
        if nxt == text:
            return text
        text = nxt


def end_run_match(symbol: str, name: str) -> bool:
    """Name matches the end of the symbol, after one libc/allocator wrapper.

    `free` matches `free` and `__libc_free`. It does not match `free_pages`
    or `buffer_free`. An ISA tail (`__memmove_avx_unaligned_erms`) still matches
    `memmove`. `copy_page` does not match `copy_page_range`.
    """
    text = strip_symbol(symbol)
    for wrapper in WRAPPERS:
        if text.startswith(wrapper) and len(text) > len(wrapper):
            text = text[len(wrapper):]
            break
    else:
        if text.startswith("__") and len(text) > 2:
            text = text[2:]
    if text == name:
        return True
    prefix = name + "_"
    if not text.startswith(prefix):
        return False
    tail = [part for part in text[len(prefix):].split("_") if part]
    return bool(tail) and all(part in ISA_TAILS for part in tail)


def prefix_match(symbol: str, name: str) -> bool:
    text = strip_symbol(symbol)
    if text == name:
        return True
    if not text.startswith(name):
        return False
    if name.endswith("_"):
        return True
    rest = text[len(name):]
    return rest.startswith("_") or bool(rest[:1].isupper())


def exact_match(symbol: str, name: str) -> bool:
    return strip_symbol(symbol) == name


@functools.lru_cache(maxsize=None)
def matches_rules(symbol: str, rules: tuple[tuple[str, str], ...]) -> bool:
    for name, mode in rules:
        if mode == "exact" and exact_match(symbol, name):
            return True
        if mode == "prefix" and prefix_match(symbol, name):
            return True
        if mode == "end-run" and end_run_match(symbol, name):
            return True
    return False


@functools.lru_cache(maxsize=None)
def is_alloc(name: str) -> bool:
    text = strip_symbol(name)
    if text.startswith("operator new") or text.startswith("operator delete"):
        return True
    if "tcmalloc" in text:
        return True
    if text.startswith(MANGLED_ALLOC):
        return True
    return matches_rules(text, ALLOC_RULES)


@functools.lru_cache(maxsize=None)
def is_copy(name: str) -> bool:
    return matches_rules(name, COPY_RULES)


@functools.lru_cache(maxsize=None)
def is_lock(name: str) -> bool:
    text = strip_symbol(name)
    if text.startswith("rw_lock_") and "_spin" in text:
        return True
    if "SpinLock" in text or "SpinLoop" in text:
        return True
    return matches_rules(text, LOCK_RULES)


@functools.lru_cache(maxsize=None)
def is_page_fault_entry(name: str) -> bool:
    return strip_symbol(name) in PAGE_FAULT_ENTRIES


@functools.lru_cache(maxsize=None)
def is_syscall_entry(name: str) -> bool:
    return strip_symbol(name) in SYSCALL_ENTRIES


def is_interpreter(name: str) -> bool:
    return strip_symbol(name) in INTERPRETER


def is_unknown(name: str) -> bool:
    return name == "[unknown]" or name.startswith("[unknown] ")


def is_idle_frame(frame: Frame) -> bool:
    # Name, not kind: --no-comm leaves swapper as an ordinary frame.
    if frame.name == "swapper" or frame.name.startswith("swapper/"):
        return True
    return frame.name in IDLE_EXACT


def is_thp_frame(name: str) -> bool:
    text = strip_symbol(name)
    return (
        text.startswith("compact_zone")
        or text.startswith("isolate_migratepages")
        or text.startswith("khugepaged")
        or text.startswith("kswapd")
        or text.startswith("shrink_")
    )


def is_net_frame(name: str) -> bool:
    text = strip_symbol(name)
    return text.startswith(("tcp_", "udp_", "ip_")) or text in {
        "napi_poll",
        "net_rx_action",
        "__netif_receive_skb",
    }


def is_sched_frame(name: str) -> bool:
    text = strip_symbol(name)
    return text in {"schedule", "__schedule", "finish_task_switch"} or text.startswith("pick_next_task")


def is_irq_frame(name: str) -> bool:
    text = strip_symbol(name)
    return text in {"common_interrupt", "do_IRQ", "__irqentry_text_start"} or text.startswith("handle_irq")


def kernel_area(name: str) -> str | None:
    if is_thp_frame(name):
        return "transparent huge pages or memory reclaim"
    if is_net_frame(name):
        return "network"
    if is_sched_frame(name):
        return "scheduler"
    if is_irq_frame(name):
        return "interrupts"
    return None


def frame_after_syscall(path: tuple[str, ...]) -> str | None:
    last = None
    for index, name in enumerate(path):
        if is_syscall_entry(name):
            last = index
    if last is None:
        return None
    for name in path[last + 1 :]:
        if is_syscall_entry(name):
            continue
        if name in SYSCALL_DISPATCH or any(name.startswith(stub) for stub in SYS_STUBS):
            continue
        return name
    return None


class View:
    def __init__(self, node: Node, parent: View | None, depth: int, path: tuple[str, ...]):
        self.node = node
        self.parent = parent
        self.children: list[View] = []
        self.depth = depth
        self.busy = 0.0
        self.busy_self = 0.0
        self.path = path


def build_view(node: Node, parent: View | None, depth: int, parent_idle: bool) -> View:
    path = () if depth == 0 else parent.path + (node.frame.name,)  # type: ignore[union-attr]
    view = View(node, parent, depth, path)
    idle = parent_idle or is_idle_frame(node.frame)
    kids = sorted(node.children.values(), key=lambda item: (item.frame.name, item.frame.kind))
    view.children = [build_view(child, view, depth + 1, idle) for child in kids]
    if idle:
        return view
    idle_below = 0.0
    for child, child_view in zip(kids, view.children):
        idle_below += child.samples - child_view.busy
    view.busy = node.samples - idle_below
    view.busy_self = view.busy - sum(child.busy for child in view.children)
    if abs(view.busy) < 1e-9:
        view.busy = 0.0
    if abs(view.busy_self) < 1e-9:
        view.busy_self = 0.0
    return view


def iter_views(view: View):
    yield view
    for child in view.children:
        yield from iter_views(child)


def short_symbol(name: str, limit: int = 72) -> str:
    if len(name) <= limit:
        return name
    return name[: limit - 1] + "…"


def path_text(names: tuple[str, ...] | list[str]) -> str:
    return _path_text(tuple(names))


@functools.lru_cache(maxsize=200_000)
def _path_text(names: tuple[str, ...]) -> str:
    shown = [short_symbol(name) for name in names]
    if len(shown) > 8:
        shown = [shown[0], "…", *shown[-4:]]
    return " → ".join(shown)


def ancestor_has_frame(view: View, name: str, kind: str) -> bool:
    parent = view.parent
    while parent is not None and parent.depth > 0:
        if parent.node.frame.name == name and parent.node.frame.kind == kind:
            return True
        parent = parent.parent
    return False


def summarize_processes(
    proc_totals: dict[str, float],
    busy: float,
    top: int,
    thread_counts: dict[str, int] | None = None,
) -> list[tuple[str, float]]:
    """Group connection threads and keep the list to threads that hold real time."""
    thread_counts = thread_counts or {}
    connections = 0.0
    connection_count = 0
    named: list[tuple[str, float]] = []
    for name, samples in proc_totals.items():
        if CONN_RE.match(name):
            connections += samples
            connection_count += thread_counts.get(name, 1)
        elif name in thread_counts:
            named.append((f"{name} ({thread_counts[name]} threads)", samples))
        else:
            named.append((name, samples))
    rows: list[tuple[str, float]] = []
    if connections > 0:
        label = f"connections ({connection_count} threads)"
        rows.append((label, connections))
    rows.extend(named)
    rows.sort(key=lambda item: (-item[1], item[0]))
    shown: list[tuple[str, float]] = []
    other = 0.0
    other_count = 0
    for name, samples in rows:
        if busy > 0 and samples / busy >= 0.01 and len(shown) < top:
            shown.append((name, samples))
        else:
            other += samples
            other_count += 1
    if other > 0 and busy > 0:
        shown.append((f"other ({other_count})", other))
    return shown


def is_passthrough(view: View) -> bool:
    return len(view.children) == 1 and view.busy_self <= 1e-9


def is_chain(view: View) -> bool:
    """A frame that hands almost all of its time to one child (thread start, dispatch layers)."""
    if view.busy <= 0:
        return False
    return any(child.busy >= 0.97 * view.busy for child in view.children)


@dataclass
class Finding:
    pct: float
    key: str
    title: str
    path: str
    steps: list[str]
    # Lower sorts first. A cause (the query stage) goes ahead of its symptom (the allocator).
    order: int = 0


@dataclass
class Report:
    total: float
    busy: float
    idle: float
    idle_label: str
    user_self: float
    kernel_self: float
    processes: list[tuple[str, float]]
    no_comm: bool
    widest: list[tuple[float, str, str]]
    hottest: list[tuple[float, str, str]]
    hottest_path: str
    findings: list[Finding]
    sample_count: int = 0
    weight: str = "samples"
    events: tuple[str, ...] = ()
    perf_overhead: float = 0.0
    unknown_self: float = 0.0
    unknown_unattributed: float = 0.0
    unknown_owners: tuple[tuple[str, float], ...] = ()
    unknown_modules: tuple[str, ...] = ()
    focus: tuple[str, float, str] | None = None


def add_finding(findings: list[Finding], finding: Finding) -> None:
    for existing in findings:
        if existing.key != finding.key:
            continue
        if finding.pct > existing.pct + 1e-9:
            existing.pct = finding.pct
            existing.title = finding.title
            existing.path = finding.path
        for step in finding.steps:
            if step not in existing.steps:
                existing.steps.append(step)
        return
    findings.append(finding)


def caller_name(view: View, pred) -> str:
    """First caller that is not matched by pred and has a name."""
    node = view.parent
    while node is not None and node.depth > 0 and (pred(node.node.frame.name) or is_unknown(node.node.frame.name)):
        node = node.parent
    if node is None or node.depth == 0 or node.node.frame.kind == "comm":
        return "the root" if node is None or node.depth == 0 else f"the {node.node.frame.name} thread"
    return node.node.frame.name


def named_owner(view: View) -> View | None:
    """The view itself when it has a name, else the nearest named caller.

    perf writes [unknown] for static or stripped functions. Their time belongs to the
    named function that called them. None when only thread-start frames are above.
    """
    node: View | None = view
    while node is not None and node.depth > 0:
        frame = node.node.frame
        if frame.kind == "comm":
            return None
        if not is_unknown(frame.name):
            if frame.name in TRUNK:
                return None
            return node
        node = node.parent
    return None


def owner_name(view: View) -> str:
    """Name used to group self time: unnamed frames count under their named caller."""
    if not is_unknown(view.node.frame.name):
        return view.node.frame.name
    owner = named_owner(view)
    return owner.node.frame.name if owner is not None else view.node.frame.name


def under(view: View, pred) -> bool:
    node = view.parent
    while node is not None and node.depth > 0:
        if pred(node.node.frame.name):
            return True
        node = node.parent
    return False


def share(part: float, whole: float) -> float:
    if whole <= 0:
        return 0.0
    return 100.0 * part / whole


def idle_label_of(root: Node) -> str:
    found: list[str] = []

    def walk(node: Node) -> None:
        if is_idle_frame(node.frame):
            found.append(node.frame.name)
        for child in node.children.values():
            walk(child)

    walk(root)
    for name in found:
        if name == "swapper" or name.startswith("swapper/"):
            return "swapper"
    return found[0] if found else "idle"


def trim_rows(rows: list[tuple[float, str, str]], total: float, top: int) -> list[tuple[float, str, str]]:
    kept: list[tuple[float, str, str]] = []
    for samples, name, path in rows:
        if total <= 0 or samples / total < LIST_MIN:
            continue
        kept.append((samples, name, path))
        if len(kept) >= top:
            break
    return kept


def spin_step(name: str, caller: str) -> str:
    return (
        f"the CPU is spinning in {name}. On-CPU samples only see the spin. "
        "Threads blocked on a futex are off-CPU and are not in this profile. "
        "Shorten or split the critical section, and take an off-CPU profile to see the waiters. "
        f"The caller is {caller}."
    )


def unknown_step(name: str, comms: set[str]) -> str:
    module = name[len("[unknown]"):].strip() if name.startswith("[unknown]") else ""
    jit = module.endswith(".map") or "perf-" in module
    library = ".so" in module
    if library:
        jit = False
    if not jit and not module:
        jit = any(comm == "java" or comm == "node" or comm.startswith("node") for comm in comms)
    if jit:
        return (
            "JIT code has no symbols. Re-record with a perf map "
            "(node --perf-basic-prof, or Java perf-map-agent). "
            "The graph cannot be trusted until then."
        )
    where = f" for {module}" if module else ""
    return f"symbols are missing{where}, so the graph cannot be trusted yet."


def group_self(
    views: list[View],
    pred,
    total: float,
) -> tuple[str, float, float, View] | None:
    matched = [view for view in views if view.depth > 0 and view.busy_self > 0 and pred(view)]
    if not matched:
        return None
    by_name: dict[str, float] = {}
    for view in matched:
        name = owner_name(view)
        by_name[name] = by_name.get(name, 0.0) + view.busy_self
    total_self = sum(by_name.values())
    top_name = sorted(by_name, key=lambda item: (-by_name[item], item))[0]
    if by_name[top_name] < CATEGORY_SELF * total and total_self < CATEGORY_GROUP * total:
        return None
    hottest = sorted(
        (view for view in matched if owner_name(view) == top_name),
        key=lambda view: (-view.busy_self, -view.busy, path_text(view.path)),
    )[0]
    return top_name, by_name[top_name], total_self, hottest


def category_entries(views: list[View], pred) -> list[View]:
    entries: list[View] = []
    for view in views:
        if view.depth == 0 or view.busy <= 0 or not pred(view.node.frame.name):
            continue
        parent = view.parent
        if parent is not None and parent.depth > 0 and pred(parent.node.frame.name):
            continue
        entries.append(view)
    return entries


def hottest_inside(entries: list[View]) -> View | None:
    best: View | None = None
    best_key: tuple[float, float, str] | None = None
    for entry in entries:
        for view in iter_views(entry):
            key = (view.busy_self, view.busy, path_text(view.path))
            if best is None or best_key is None:
                best, best_key = view, key
                continue
            better = (
                key[0] > best_key[0] + 1e-9
                or (abs(key[0] - best_key[0]) <= 1e-9 and key[1] > best_key[1] + 1e-9)
                or (abs(key[0] - best_key[0]) <= 1e-9 and abs(key[1] - best_key[1]) <= 1e-9 and key[2] < best_key[2])
            )
            if better:
                best, best_key = view, key
    return best


def analyze(root: Node, top: int = 8) -> Report:
    if top < 1:
        raise SystemExit("--top must be at least 1")
    meta = root.meta or {}
    view_root = build_view(root, None, 0, False)
    views = list(iter_views(view_root))
    busy = view_root.busy
    idle = root.samples - busy
    if abs(idle) < 1e-9:
        idle = 0.0
    kernel_self = sum(view.busy_self for view in views if view.node.frame.kind == "kernel")
    user_self = busy - kernel_self
    perf_overhead = sum(
        view.busy_self for view in views if view.node.frame.kind == "kernel" and strip_symbol(view.node.frame.name) in PERF_OVERHEAD
    )
    comms = [view for view in views if view.node.frame.kind == "comm"]
    proc_totals: dict[str, float] = {}
    for view in comms:
        if view.busy <= 0:
            continue
        proc_totals[view.node.frame.name] = proc_totals.get(view.node.frame.name, 0.0) + view.busy
    processes = summarize_processes(proc_totals, busy, top, meta.get("threads") or {})
    no_comm = not comms

    groups: dict[tuple[str, str], list[View]] = {}
    for view in views:
        if view.depth == 0 or view.node.frame.kind in ("comm", "root") or view.busy <= 0:
            continue
        groups.setdefault((view.node.frame.name, view.node.frame.kind), []).append(view)

    wide_rows: list[tuple[float, str, str]] = []
    for (name, kind), members in groups.items():
        # [unknown] merges every unnamed address in a module into one name. Its width is not one function.
        if is_unknown(name):
            continue
        if all(is_passthrough(member) or is_chain(member) for member in members):
            continue
        inclusive = 0.0
        for member in members:
            # The same sample often passes through one function many times.
            # Count it at the first visit so inclusive time cannot exceed 100%.
            if ancestor_has_frame(member, name, kind):
                continue
            inclusive += member.busy
        if inclusive > 0:
            best = sorted(members, key=lambda member: (-member.busy, member.depth, path_text(member.path)))[0]
            wide_rows.append((inclusive, name, path_text(best.path)))

    # Self time. Unnamed frames are listed as "[unknown] in <named caller>".
    self_totals: dict[str, float] = {}
    self_best: dict[str, View] = {}
    unknown_self = 0.0
    unattributed = 0.0
    owners: dict[str, float] = {}
    modules: dict[str, float] = {}
    for view in views:
        if view.depth == 0 or view.node.frame.kind in ("comm", "root") or view.busy_self <= 0:
            continue
        name = view.node.frame.name
        label = name
        if is_unknown(name):
            unknown_self += view.busy_self
            owner = named_owner(view)
            if owner is None:
                unattributed += view.busy_self
                module = name[len("[unknown]"):].strip() or "unknown"
                modules[module] = modules.get(module, 0.0) + view.busy_self
            else:
                owners[owner.node.frame.name] = owners.get(owner.node.frame.name, 0.0) + view.busy_self
                label = f"[unknown] in {owner.node.frame.name}"
        self_totals[label] = self_totals.get(label, 0.0) + view.busy_self
        current = self_best.get(label)
        key = (-view.busy_self, -view.busy, path_text(view.path))
        if current is None or key < (-current.busy_self, -current.busy, path_text(current.path)):
            self_best[label] = view
    self_rows = [(total, label, path_text(self_best[label].path)) for label, total in self_totals.items()]
    wide_rows.sort(key=lambda row: (-row[0], row[1]))
    self_rows.sort(key=lambda row: (-row[0], row[2], row[1]))
    widest = trim_rows(wide_rows, busy, top)
    hottest = trim_rows(self_rows, busy, top)
    hottest_path = self_rows[0][2] if self_rows else "(none)"

    focus = _work_focus(views, busy)
    findings: list[Finding] = []
    if busy > 0:
        _collect_findings(findings, views, busy, set(proc_totals), unattributed, modules)
        _stage_finding(findings, views, busy)
        findings.sort(key=lambda finding: (finding.order, -finding.pct, finding.title))
        if not findings:
            spread = _spread_finding(views, busy)
            if spread is not None:
                findings.append(spread)

    return Report(
        total=root.samples,
        busy=busy,
        idle=idle,
        idle_label=idle_label_of(root) if idle else "",
        user_self=user_self,
        kernel_self=kernel_self,
        processes=processes,
        no_comm=no_comm,
        widest=widest,
        hottest=hottest,
        hottest_path=hottest_path,
        findings=findings,
        sample_count=int(meta.get("sample_count", 0) or 0),
        weight=str(meta.get("weight", "samples")),
        events=tuple(meta.get("events") or ()),
        perf_overhead=perf_overhead,
        unknown_self=unknown_self,
        unknown_unattributed=unattributed,
        unknown_owners=tuple(sorted(owners.items(), key=lambda item: (-item[1], item[0]))),
        unknown_modules=tuple(sorted(modules, key=lambda item: (-modules[item], item))),
        focus=focus,
    )


def _collect_findings(
    findings: list[Finding],
    views: list[View],
    busy: float,
    comms: set[str],
    unattributed: float = 0.0,
    modules: dict[str, float] | None = None,
) -> None:
    # Self time by function. Unnamed frames count under the named function that called them.
    by_name: dict[str, float] = {}
    unnamed_part: dict[str, float] = {}
    best_for: dict[str, View] = {}
    for view in views:
        if view.depth == 0 or view.busy_self <= 0 or view.node.frame.kind in ("comm", "root"):
            continue
        name = owner_name(view)
        by_name[name] = by_name.get(name, 0.0) + view.busy_self
        if name != view.node.frame.name:
            unnamed_part[name] = unnamed_part.get(name, 0.0) + view.busy_self
        current = best_for.get(name)
        if current is None:
            best_for[name] = view
            continue
        current_key = (-current.busy_self, -current.busy, path_text(current.path))
        new_key = (-view.busy_self, -view.busy, path_text(view.path))
        if new_key < current_key:
            best_for[name] = view

    interp_names = [name for name in by_name if is_interpreter(name)]
    interp_self = sum(by_name[name] for name in interp_names)
    if interp_self >= INTERPRETER_SELF * busy and interp_names:
        top_interp = sorted(interp_names, key=lambda name: (-by_name[name], path_text(best_for[name].path)))[0]
        hot = best_for[top_interp]
        add_finding(
            findings,
            Finding(
                pct=share(by_name[top_interp], busy),
                key=top_interp,
                title=f"{top_interp} is {share(by_name[top_interp], busy):.1f}% of self time",
                path=path_text(hot.path),
                steps=["this is the Python eval loop, not your function. Re-record with python -X perf (3.12+)."],
            ),
        )

    def unnamed_note(name: str) -> list[str]:
        part = unnamed_part.get(name, 0.0)
        if part <= 0:
            return []
        return [
            f"{share(part, busy):.1f} of those {share(by_name[name], busy):.1f} points are unnamed code that {name} calls "
            "(static or inlined functions with no symbol). Install debug symbols to name them."
        ]

    ranked = sorted(by_name, key=lambda name: (-by_name[name], path_text(best_for[name].path)))
    for name in ranked:
        if is_interpreter(name) or is_unknown(name):
            continue
        if by_name[name] < DOMINANT_SELF * busy:
            break
        hot = best_for[name]
        add_finding(
            findings,
            Finding(
                pct=share(by_name[name], busy),
                key=name,
                title=f"{name} is {share(by_name[name], busy):.1f}% of self time",
                path=path_text(hot.path),
                steps=[
                    f"optimize {name} first. This is where the CPU was. "
                    "If it is server code you do not build, reduce the work that reaches it: the path shows the caller.",
                    *unnamed_note(name),
                ],
            ),
        )
        break

    def alloc_pred(view: View) -> bool:
        return is_alloc(owner_name(view))

    def copy_pred(view: View) -> bool:
        if not is_copy(owner_name(view)):
            return False
        return not any(is_page_fault_entry(name) for name in view.path)

    def lock_pred(view: View) -> bool:
        # A lock taken inside the allocator is reported with the allocator.
        return is_lock(owner_name(view)) and not under(view, is_alloc)

    def emit_group(found, step: str) -> None:
        if found is None:
            return
        name, own, total_self, hot = found
        steps = []
        if total_self > own + 1e-9:
            steps.append(f"matching frames add up to {share(total_self, busy):.1f}% of self time.")
        steps.append(step)
        add_finding(
            findings,
            Finding(
                pct=share(total_self, busy),
                key=name,
                title=f"{name} is {share(own, busy):.1f}% of self time",
                path=path_text(hot.path),
                steps=steps,
            ),
        )

    if not _allocator_finding(findings, views, busy):
        alloc = group_self(views, alloc_pred, busy)
        if alloc is not None:
            _name, _own, _total_self, hot = alloc
            emit_group(alloc, f"cut the allocation rate. The caller is {caller_name(hot, is_alloc)}.")
    copied = group_self(views, copy_pred, busy)
    if copied is not None:
        _name, _own, _total_self, hot = copied
        emit_group(copied, f"cut copies. The caller is {caller_name(hot, is_copy)}.")
    locked = group_self(views, lock_pred, busy)
    if locked is not None:
        _name, _own, _total_self, hot = locked
        emit_group(locked, spin_step(_name, caller_name(hot, is_lock)))

    for label, rules in LIBRARY_GROUPS:
        pred = lambda item, rules=rules: matches_rules(item, rules)
        entries = category_entries(views, pred)
        if not entries:
            continue
        inclusive = sum(entry.busy for entry in entries)
        if inclusive < LIBRARY_INCLUSIVE * busy:
            continue
        hot = hottest_inside(entries)
        if hot is None:
            continue
        entry = sorted(entries, key=lambda item: (-item.busy, path_text(item.path)))[0]
        caller = caller_name(hot, pred)
        if hot.node.frame.name == entry.node.frame.name:
            step = f"the cost is in this {label} code. The caller is {caller}."
        else:
            step = (
                f"the cost is in this {label} code. The hottest frame is {hot.node.frame.name}. "
                f"The caller is {caller}."
            )
        add_finding(
            findings,
            Finding(
                pct=share(inclusive, busy),
                key=entry.node.frame.name,
                title=f"{entry.node.frame.name} is {share(inclusive, busy):.1f}% of inclusive time",
                path=path_text(hot.path),
                steps=[step],
            ),
        )

    fault_entries = category_entries(views, is_page_fault_entry)
    if fault_entries:
        inclusive = sum(entry.busy for entry in fault_entries)
        if inclusive >= PAGE_FAULT_INCLUSIVE * busy:
            hot = hottest_inside(fault_entries)
            entry = sorted(fault_entries, key=lambda item: (-item.busy, path_text(item.path)))[0]
            if hot is not None:
                if hot.node.frame.name == entry.node.frame.name:
                    step = "the program is touching new memory."
                else:
                    step = f"the program is touching new memory. The hottest frame is {hot.node.frame.name}."
                add_finding(
                    findings,
                    Finding(
                        pct=share(inclusive, busy),
                        key=entry.node.frame.name,
                        title=f"{entry.node.frame.name} is {share(inclusive, busy):.1f}% of inclusive time",
                        path=path_text(hot.path),
                        steps=[step],
                    ),
                )

    _kernel_finding(findings, views, busy)
    _unknown_finding(findings, views, busy, comms, unattributed, modules or {})
    _deep_finding(findings, views, busy)


SLOW_PATH_WORDS = ("Refill", "DeallocateSlow", "UpdateCapacity", "Overflow", "Underflow", "TransferCache",
                   "CentralFreeList", "PageHeap", "PageAllocator", "RemoveRange", "InsertRange")


def _slow_path_owners(entries: list[View]) -> list[tuple[str, float]]:
    """Named allocator frames above the lock spin, such as CpuCache::Refill."""
    owners: dict[str, float] = {}
    for entry in entries:
        for view in iter_views(entry):
            if view.busy_self <= 0:
                continue
            target = frame_after_syscall(view.path) if view.node.frame.kind == "kernel" else None
            futex_call = bool(target) and strip_symbol(target).lstrip("_").startswith(("do_futex", "futex"))
            if not (is_lock(view.node.frame.name) or futex_call):
                continue
            node = view.parent
            while node is not None and node.depth > 0:
                name = node.node.frame.name
                if any(word in name for word in SLOW_PATH_WORDS):
                    short = re.sub(r"<.*>", "<…>", name)
                    owners[short] = owners.get(short, 0.0) + view.busy_self
                    break
                node = node.parent
    return sorted(owners.items(), key=lambda item: (-item[1], item[0]))


FOCUS_SHARE = 0.40
STAGE_SHARE = 0.20
# MongoDB query engine frames and what a DBA calls them. Matched as substrings of the symbol.
MONGO_STAGES = (
    ("DocumentSourceLookUp::", "the $lookup stage"),
    ("DocumentSourceGroup::", "the $group stage"),
    ("DocumentSourceSort::", "the $sort stage"),
    ("mongo::SortStage::", "an in-memory sort (SORT)"),
    ("mongo::CollectionScan::", "collection scans (COLLSCAN)"),
    ("mongo::IndexScan::", "index scans (IXSCAN)"),
    ("__wt_evict", "WiredTiger cache eviction"),
)


def _first_visits(views: list[View], pred) -> dict[str, list[View]]:
    found: dict[str, list[View]] = {}
    for view in views:
        if view.depth == 0 or view.busy <= 0 or view.node.frame.kind != "user":
            continue
        name = view.node.frame.name
        if not pred(name) or ancestor_has_frame(view, name, "user"):
            continue
        found.setdefault(name, []).append(view)
    return found


def _work_focus(views: list[View], busy: float) -> tuple[str, float, str] | None:
    """The deepest named function that still holds a large share: where the work narrows."""
    if busy <= 0:
        return None

    def usable(name: str) -> bool:
        return not (is_unknown(name) or is_alloc(name) or is_interpreter(name) or name in TRUNK)

    best: tuple[int, float, str, View] | None = None
    for name, members in _first_visits(views, usable).items():
        inclusive = sum(member.busy for member in members)
        if inclusive < FOCUS_SHARE * busy:
            continue
        depth = min(member.depth for member in members)
        top = max(members, key=lambda member: member.busy)
        key = (depth, inclusive, name, top)
        if best is None or (depth, inclusive) > (best[0], best[1]):
            best = key
    if best is None:
        return None
    return best[2], best[1], path_text(best[3].path)


def _alloc_under(members: list[View]) -> float:
    total = 0.0
    for member in members:
        total += sum(entry.busy for entry in category_entries(list(iter_views(member)), is_alloc))
    return total


def _stage_finding(findings: list[Finding], views: list[View], busy: float) -> None:
    """Name the MongoDB query stage that holds the work, when the profile is from mongod."""
    if not any(view.node.frame.name.startswith(("mongo::", "__wt_")) for view in views):
        return
    best: tuple[float, str, str, list[View]] | None = None
    for needle, label in MONGO_STAGES:
        groups = _first_visits(views, lambda name, needle=needle: needle in name)
        members = [member for group in groups.values() for member in group]
        # Count each sample once even when several frames of the stage are on its stack.
        members = [member for member in members if not any(needle in name for name in member.path[:-1])]
        inclusive = sum(member.busy for member in members)
        if inclusive >= STAGE_SHARE * busy and (best is None or inclusive > best[0]):
            best = (inclusive, needle, label, members)
    if best is None:
        return
    inclusive, needle, label, members = best
    top = max(members, key=lambda member: member.busy)
    steps: list[str] = []
    alloc = _alloc_under(members)
    alloc_total = sum(entry.busy for entry in category_entries(views, is_alloc))
    cause = False
    if alloc >= 0.05 * busy:
        part = share(alloc, alloc_total)
        steps.append(
            f"{share(alloc, busy):.1f}% of the profile is memory allocation inside {label}: "
            f"{part:.0f}% of all allocator time."
        )
        cause = part >= 50
    if needle == "DocumentSourceLookUp::":
        build = _first_visits(views, lambda name: "DocumentSourceLookUp::buildPipeline" in name)
        build_time = sum(member.busy for group in build.values() for member in group)
        if build_time >= 0.5 * inclusive:
            steps.append(
                f"{share(build_time, busy):.1f}% is building the inner pipeline (DocumentSourceLookUp::buildPipeline: "
                "parse, optimize and plan), more than running it. $lookup runs its inner pipeline for every "
                "document that reaches it, so this cost grows with the number of input documents."
            )
        steps.append(
            "find the aggregation with $lookup (slow query log, db.currentOp(), or the profiler). "
            "Put a $match before $lookup to send fewer documents into it, and check the foreign collection "
            "has an index on the joined field (explain the inner query)."
        )
    elif needle == "mongo::CollectionScan::":
        steps.append("find the queries with COLLSCAN in explain() or the slow query log, and add an index that fits them.")
    elif needle in ("DocumentSourceSort::", "mongo::SortStage::"):
        steps.append("an index that matches the sort removes the in-memory sort. Check explain() for a SORT stage.")
    elif needle == "DocumentSourceGroup::":
        steps.append("filter with $match and trim fields with $project before $group to feed it fewer, smaller documents.")
    elif needle == "mongo::IndexScan::":
        steps.append("compare keysExamined with nReturned in explain(). A large gap means the index is not selective for these queries.")
    elif needle == "__wt_evict":
        steps.append("check WiredTiger cache pressure: db.serverStatus().wiredTiger.cache dirty and used bytes against the eviction targets.")
    add_finding(
        findings,
        Finding(
            pct=share(inclusive, busy),
            key=f"stage:{needle}",
            title=f"{label} is {share(inclusive, busy):.1f}% of inclusive time",
            path=path_text(top.path),
            steps=steps,
            order=-1 if cause else 0,
        ),
    )


def allocator_family(names) -> str:
    joined = " ".join(names)
    if "tcmalloc" in joined:
        return "tcmalloc"
    if "je_" in joined or "jemalloc" in joined:
        return "jemalloc"
    if "mi_" in joined or "mimalloc" in joined:
        return "mimalloc"
    return "the allocator"


def _allocator_finding(findings: list[Finding], views: list[View], busy: float) -> bool:
    """Inclusive allocator time: malloc/free/new/delete plus everything they call.

    Self time alone undercounts the allocator. Its locks, its unnamed static
    functions, and the page faults it takes all sit below the entry point.
    """
    entries = category_entries(views, is_alloc)
    if not entries:
        return False
    inclusive = sum(entry.busy for entry in entries)
    if inclusive < ALLOC_INCLUSIVE * busy:
        return False
    names: set[str] = set()
    named_self = 0.0
    for entry in entries:
        for view in iter_views(entry):
            if view.busy_self > 0 and is_alloc(view.node.frame.name):
                named_self += view.busy_self
    # When the allocator's own named frames already explain its time, the self-time finding says it.
    if inclusive - named_self < 0.03 * busy:
        return False
    spin = 0.0
    user_spin = 0.0
    kernel_lock = 0.0
    kernel = 0.0
    spin_name = ""
    spin_by: dict[str, float] = {}
    kernel_by: dict[str, float] = {}
    for entry in entries:
        for view in iter_views(entry):
            names.add(view.node.frame.name)
            if view.busy_self <= 0:
                continue
            target = frame_after_syscall(view.path) if view.node.frame.kind == "kernel" else None
            futex_call = bool(target) and strip_symbol(target).lstrip("_").startswith(("do_futex", "futex"))
            if is_lock(view.node.frame.name) or futex_call:
                spin += view.busy_self
                if view.node.frame.kind == "kernel":
                    kernel_lock += view.busy_self
                else:
                    user_spin += view.busy_self
                    spin_by[view.node.frame.name] = spin_by.get(view.node.frame.name, 0.0) + view.busy_self
            elif view.node.frame.kind == "kernel":
                kernel += view.busy_self
                if any(is_page_fault_entry(name) for name in view.path):
                    area = "page faults"
                else:
                    target = frame_after_syscall(view.path)
                    area = target if target else "interrupts and scheduler"
                kernel_by[area] = kernel_by.get(area, 0.0) + view.busy_self
    if spin_by:
        spin_name = sorted(spin_by, key=lambda item: (-spin_by[item], item))[0]
    callers: dict[str, float] = {}
    for entry in entries:
        caller = caller_name(entry, is_alloc)
        callers[caller] = callers.get(caller, 0.0) + entry.busy
    family = allocator_family(names)
    spin_views = [
        view for entry in entries for view in iter_views(entry) if view.busy_self > 0 and is_lock(view.node.frame.name)
    ]
    if spin >= 0.02 * busy and spin_views:
        hot = sorted(spin_views, key=lambda view: (-view.busy_self, -view.busy, path_text(view.path)))[0]
    else:
        hot = hottest_inside(entries)
    top = sorted(entries, key=lambda item: (-item.busy, path_text(item.path)))[0]
    steps: list[str] = []
    if spin >= 0.02 * busy:
        parts = []
        if user_spin > 0:
            parts.append(f"{share(user_spin, busy):.1f}% spinning in {short_symbol(spin_name, 80)}")
        if kernel_lock > 0:
            parts.append(f"{share(kernel_lock, busy):.1f}% in the futex calls and kernel spinlocks behind it")
        steps.append(
            f"{share(spin, busy):.1f}% is lock contention inside {family}: {', '.join(parts)}. "
            "The lock belongs to the allocator, not to application data."
        )
        slow = _slow_path_owners(entries)
        if slow:
            listed = ", ".join(f"{short_symbol(name, 70)} ({share(value, busy):.1f}%)" for name, value in slow[:3])
            per_cpu = any("cpu_cache" in name.lower() or "CpuCache" in name for name, _value in slow)
            if per_cpu:
                steps.append(
                    f"the lock is reached from the per-CPU cache slow path: {listed}. "
                    "A thread goes there when its CPU's cache is empty (Refill) or full (Deallocate slow path), "
                    "or when the cache is resized (UpdateCapacity). The shared caches behind it are locked."
                )
            else:
                steps.append(f"the lock is reached from: {listed}.")
    if kernel >= 0.02 * busy:
        areas = sorted(kernel_by.items(), key=lambda item: (-item[1], item[0]))[:3]
        listed = ", ".join(f"{name} ({share(value, busy):.1f}%)" for name, value in areas)
        steps.append(f"{share(kernel, busy):.1f}% is other kernel time under the allocator: {listed}.")
    ranked_callers = sorted(callers.items(), key=lambda item: (-item[1], item[0]))[:3]
    caller_text = ", ".join(f"{short_symbol(name, 80)} ({share(value, busy):.1f}%)" for name, value in ranked_callers)
    covered = sum(value for _name, value in ranked_callers)
    if covered < 0.5 * inclusive:
        steps.append(
            f"cut the allocation rate. No single caller dominates: the top three ({caller_text}) cover "
            f"{share(covered, inclusive):.0f}% of the allocator time, from {len(callers)} callers. "
            "The cost is the allocation rate of the whole request path, not one function."
        )
    else:
        steps.append(f"cut the allocation rate in the callers: {caller_text}.")
    if family == "tcmalloc":
        per_cpu = any("cpu_cache" in name or "CpuCache" in name for name in names)
        per_thread = any("ThreadCache" in name for name in names)
        if any(view.node.frame.name.startswith(("mongo::", "__wt_")) for view in views):
            if per_thread and not per_cpu:
                steps.append(
                    "for mongod 8.0 and later: the stacks show tcmalloc's per-thread cache, not the per-CPU cache. "
                    "Check db.serverStatus().tcmalloc.usingPerCPUCaches. If it is false, start mongod with "
                    "GLIBC_TUNABLES=glibc.pthread.rseq=0 on a 4.18 or newer kernel, as the MongoDB tcmalloc "
                    "performance page describes."
                )
            else:
                steps.append(
                    "for mongod: the per-CPU cache is in use (CpuCache frames). Take db.serverStatus().tcmalloc "
                    "twice, a minute apart, during the load, and compare the per-CPU, transfer cache and central "
                    "free list figures. Shared-cache activity that grows with load matches the lock time here."
                )
        else:
            steps.append("compare the tcmalloc statistics during the load: per-CPU cache, transfer cache and central free list.")
    add_finding(
        findings,
        Finding(
            pct=share(inclusive, busy),
            key="alloc:inclusive",
            title=f"memory allocation ({family}) is {share(inclusive, busy):.1f}% of inclusive time",
            path=path_text((hot or top).path),
            steps=steps,
        ),
    )
    return True


def _kernel_finding(findings: list[Finding], views: list[View], busy: float) -> None:
    all_kernel = [view for view in views if view.node.frame.kind == "kernel" and view.busy_self > 0]
    # perf re-arming its counters is measurement overhead. It is reported apart, not as a kernel problem.
    kernel_views = [view for view in all_kernel if strip_symbol(view.node.frame.name) not in PERF_OVERHEAD]
    kern_self = sum(view.busy_self for view in kernel_views)
    if kern_self < KERNEL_SELF * busy or not kernel_views:
        if not kernel_views and all_kernel:
            overhead = sum(view.busy_self for view in all_kernel)
            if overhead >= KERNEL_SELF * busy:
                hot = sorted(all_kernel, key=lambda view: (-view.busy_self, -view.busy, path_text(view.path)))[0]
                add_finding(
                    findings,
                    Finding(
                        pct=share(overhead, busy),
                        key=f"kernel:{hot.node.frame.name}",
                        title=f"perf overhead is {share(overhead, busy):.1f}% of self time",
                        path=path_text(hot.path),
                        steps=[
                            f"this is perf turning its counter back on during a context switch ({hot.node.frame.name}). "
                            "That time is not spent in the application."
                        ],
                    ),
                )
        return

    def bucket(view: View) -> str:
        if any(is_page_fault_entry(name) for name in view.path):
            return "page-fault"
        if is_lock(view.node.frame.name):
            return "spinlock"
        if any(is_syscall_entry(name) for name in view.path):
            return "syscall"
        return "other"

    totals: dict[str, float] = {}
    for view in kernel_views:
        kind = bucket(view)
        totals[kind] = totals.get(kind, 0.0) + view.busy_self
    kind = sorted(totals, key=lambda item: (-totals[item], item))[0]
    if kind == "page-fault":
        return
    members = [view for view in kernel_views if bucket(view) == kind]
    hot = sorted(members, key=lambda view: (-view.busy_self, -view.busy, path_text(view.path)))[0]
    if hot.node.frame.name in PERF_OVERHEAD:
        add_finding(
            findings,
            Finding(
                pct=share(kern_self, busy),
                key=f"kernel:{hot.node.frame.name}",
                title=f"kernel time is {share(kern_self, busy):.1f}% of self time",
                path=path_text(hot.path),
                steps=[
                    f"this is perf turning its counter back on during a context switch ({hot.node.frame.name}). "
                    "That time is not spent in the application."
                ],
            ),
        )
        return
    if kind == "spinlock":
        add_finding(
            findings,
            Finding(
                pct=share(kern_self, busy),
                key=hot.node.frame.name,
                title=f"kernel time is {share(kern_self, busy):.1f}% of self time",
                path=path_text(hot.path),
                steps=[spin_step(hot.node.frame.name, caller_name(hot, is_lock))],
            ),
        )
        return
    if kind == "syscall":
        target = frame_after_syscall(hot.path) or hot.node.frame.name
        area = kernel_area(target)
        extra = f" ({area})" if area else ""
        step = f"syscalls spend it in {target}{extra}."
        key = f"kernel:{target}"
    else:
        area = kernel_area(hot.node.frame.name)
        if area:
            step = f"kernel time is in {hot.node.frame.name} ({area})."
        else:
            step = f"kernel time is in {hot.node.frame.name}."
        key = f"kernel:{hot.node.frame.name}"
    add_finding(
        findings,
        Finding(
            pct=share(kern_self, busy),
            key=key,
            title=f"kernel time is {share(kern_self, busy):.1f}% of self time",
            path=path_text(hot.path),
            steps=[step],
        ),
    )


def _unknown_finding(
    findings: list[Finding],
    views: list[View],
    busy: float,
    comms: set[str],
    unattributed: float = 0.0,
    modules: dict[str, float] | None = None,
) -> None:
    """Raise missing symbols only for unnamed time that has no named caller.

    Unnamed frames under a named function are counted with that function, so a
    stripped static helper inside tcmalloc or WiredTiger does not hide the profile.
    """
    modules = modules or {}
    unknown_views = [
        view for view in views
        if view.depth > 0 and is_unknown(view.node.frame.name) and view.busy > 0 and named_owner(view) is None
    ]
    if not unknown_views:
        return
    # A wide [unknown] band is harmless when named frames above it explain the time.
    # What matters is self time that ends in unnamed code with no named caller.
    if unattributed < UNKNOWN_SHARE * busy:
        return
    chosen = sorted(
        [view for view in unknown_views if view.busy_self > 0] or unknown_views,
        key=lambda view: (-view.busy_self, -view.busy, path_text(view.path)),
    )[0]
    samples = unattributed
    word = "self time"
    name = chosen.node.frame.name
    steps = [unknown_step(name, comms)]
    if len(modules) > 1:
        listed = ", ".join(f"{module} ({share(value, busy):.1f}%)" for module, value in
                           sorted(modules.items(), key=lambda item: (-item[1], item[0]))[:4])
        steps.append(f"unnamed self time by module: {listed}.")
    add_finding(
        findings,
        Finding(
            pct=share(samples, busy),
            key=name,
            title=(
                f"{name} is {share(samples, busy):.1f}% of {word}"
                if len(modules) <= 1
                else f"[unknown] code is {share(samples, busy):.1f}% of {word}, most of it in {name}"
            ),
            path=path_text(chosen.path),
            steps=steps,
        ),
    )


def _deep_finding(findings: list[Finding], views: list[View], busy: float) -> None:
    best: tuple[float, str, str, str] | None = None
    for view in views:
        if view.busy_self <= 0:
            continue
        if view.busy_self < DEEP_SHARE * busy:
            continue
        # [unknown] is many different addresses under one name. Its repeats are not recursion.
        meaningful = [name for name in view.path if not is_interpreter(name) and not is_unknown(name)]
        counts: dict[str, int] = {}
        for name in meaningful:
            counts[name] = counts.get(name, 0) + 1
        repeated = sorted(((count, name) for name, count in counts.items() if count >= REPEAT_TIMES), reverse=True)
        deep = len(meaningful) >= DEEP_FRAMES
        if not repeated and not deep:
            continue
        if repeated:
            count, name = repeated[0]
            title = f"{name} repeats {count} times on one stack ({share(view.busy_self, busy):.1f}% of the profile)"
            key = f"deep:{name}"
        else:
            name = meaningful[-1] if meaningful else view.node.frame.name
            title = (
                f"one stack is {len(meaningful)} frames deep "
                f"({share(view.busy_self, busy):.1f}% of the profile)"
            )
            key = f"deep:{name}"
        rank = view.busy_self
        if best is None or rank > best[0]:
            best = (rank, key, title, path_text(view.path))
    if best is None:
        return
    _rank, key, title, path = best
    add_finding(
        findings,
        Finding(
            pct=best[0] / busy * 100.0,
            key=key,
            title=title,
            path=path,
            steps=["this is recursion or a callback loop. Bound the depth or stop the repeat."],
        ),
    )


def _spread_finding(views: list[View], busy: float) -> Finding | None:
    candidates: list[View] = []
    for view in views:
        if view.depth == 0 or view.node.frame.kind in ("comm", "root"):
            continue
        if view.busy < SPREAD_INCLUSIVE * busy:
            continue
        if view.busy_self >= SPREAD_SELF * busy:
            continue
        if not view.children:
            continue
        if any(child.busy >= SPREAD_CHILD * view.busy for child in view.children):
            continue
        candidates.append(view)
    if not candidates:
        return None
    chosen = sorted(candidates, key=lambda view: (-view.depth, -view.busy, view.node.frame.name))[0]
    name = chosen.node.frame.name
    return Finding(
        pct=share(chosen.busy, busy),
        key=f"spread:{name}",
        title=f"time is spread out under {name} ({share(chosen.busy, busy):.1f}% inclusive)",
        path=path_text(chosen.path),
        steps=[f"no single hotspot. The time splits under {name}."],
    )


def sample_line(report: Report) -> str:
    count = report.sample_count or report.total
    if report.weight == "period":
        event = ", ".join(report.events) if report.events else "the sampled event"
        return f"{fmt_num(count)} samples, weighted by event count ({event})"
    if report.weight == "folded":
        return f"{fmt_num(report.total)} weight in {fmt_num(count)} folded stacks"
    return f"{fmt_num(count)} samples"


def render_report(report: Report) -> str:
    lines = ["Flame report", sample_line(report), "", *HOW_TO, "", "Where the samples went"]
    if report.idle > 0 and report.total > 0:
        lines.append(
            f"  {'idle':<8} {share(report.idle, report.total):5.1f}%  ({report.idle_label}, excluded below)"
        )
    if report.busy <= 0:
        lines.append("  all samples are idle")
    else:
        if report.idle > 0:
            lines.append(f"Percentages below are of the {share(report.busy, report.total):.1f}% of the profile that is not idle.")
        lines.append(f"  {'user':<8} {share(report.user_self, report.busy):5.1f}%")
        lines.append(f"  {'kernel':<8} {share(report.kernel_self, report.busy):5.1f}%")
        if report.no_comm:
            lines.append("  process names were not recorded")
        else:
            for name, samples in report.processes:
                lines.append(f"  {name:<8} {share(samples, report.busy):5.1f}%")
    lines.append("")
    lines.append("Widest frames")
    lines.extend(_metric_lines(report.widest, report.busy))
    lines.append("")
    lines.append("Hottest self time")
    lines.extend(_metric_lines(report.hottest, report.busy))
    lines.append("")
    lines.append("Hottest path")
    lines.append(f"  {report.hottest_path}")
    if report.focus is not None:
        name, samples, path = report.focus
        lines.append("")
        lines.append("Where the work narrows")
        lines.append(f"  {share(samples, report.busy):5.1f}%  {short_symbol(name, 120)}")
        lines.append(f"  {path}")
    lines.append("")
    lines.append("Findings")
    if not report.findings:
        lines.append("No single CPU problem in this profile.")
    else:
        for index, finding in enumerate(report.findings, start=1):
            if index > 1:
                lines.append("")
            lines.append(f"{index}. {finding.title}")
            lines.append(f"   Path: {finding.path}")
            for step in finding.steps:
                lines.append(f"   Next: {step}")
    notes = profile_notes(report)
    if notes:
        lines.append("")
        lines.append("Notes")
        for item in notes:
            lines.append(f"  - {item}")
    lines.append("")
    return "\n".join(lines)


def svg_embedded(markup: str) -> str:
    if markup.startswith("<?xml"):
        markup = markup.split("\n", 1)[1]
    return markup.replace("<![CDATA[\n", "").replace("]]>", "")


def _unknown_module(name: str) -> str:
    if not name.startswith("[unknown]"):
        return ""
    return name[len("[unknown]"):].strip()


ACTION_STARTS = (
    "cut ", "find ", "check ", "compare ", "optimize ", "install ", "run ", "record ", "re-record", "put ",
    "take ", "reduce ", "filter ", "shorten ", "bound ", "use ", "for mongod", "an index", "jit code",
    "this is the python", "this is recursion", "the cpu is spinning", "or run", "do not tune",
)


def is_action(step: str) -> bool:
    """A step that says what to do, as opposed to evidence about where the time went."""
    return step.strip().lower().startswith(ACTION_STARTS)


def sentence_case(text: str) -> str:
    """Capitalize a plain English first word. Leave code names such as mongod or __wt_x alone."""
    first = text.split(" ", 1)[0]
    if first.isalpha() and first.islower() and first not in {"mongod", "mysqld", "postgres", "perf", "tcmalloc", "jemalloc"}:
        return text[:1].upper() + text[1:]
    return text


def profile_notes(report: Report) -> list[str]:
    """Notes on how to read the numbers: unnamed code, perf overhead, weighting."""
    busy = report.busy if report.busy > 0 else report.total
    unusual: list[str] = []
    attributed = report.unknown_self - report.unknown_unattributed
    if busy and attributed >= 0.05 * busy and report.unknown_owners:
        owners = ", ".join(
            f"{short_symbol(name, 80)} ({share(value, busy):.1f}%)" for name, value in report.unknown_owners[:3]
        )
        unusual.append(
            f"{share(attributed, busy):.1f}% of self time is in functions with no symbol. "
            f"It is counted under the named function that called them: {owners}. "
            "Debug symbols for the binary would name the exact function."
        )
    if busy and report.perf_overhead >= PERF_NOTE * busy:
        unusual.append(
            f"{share(report.perf_overhead, busy):.1f}% of the profile is perf itself re-arming its counters "
            "(native_write_msr, perf_adjust_freq_unthr_context). It is measurement overhead, not the application."
        )
    if report.weight == "period":
        unusual.append(
            "Percentages are weighted by event count (the period on each sample), as perf report does. "
            "Use --weight samples to count every sample as one."
        )
    return unusual


def conclusion_points(report: Report) -> tuple[list[str], list[str], list[str]]:
    """What is wrong, how to fix it, and what looks unusual. Grounded in this profile."""
    busy = report.busy if report.busy > 0 else report.total
    wrong: list[str] = []
    fix: list[str] = []
    unusual: list[str] = []
    unknown_finding = next((item for item in report.findings if item.title.startswith("[unknown]")), None)
    modules = list(report.unknown_modules)
    libc_unknown = any("libc" in module or "libpthread" in module or module.startswith("ld-") for module in modules)
    kernel_unknown = any("kernel" in module for module in modules)

    if unknown_finding is not None:
        wrong.append(
            f"{unknown_finding.title}. The capture shows which program was on CPU, not which function. "
            "Do not treat a wide yellow or blue band as a code hotspot until it has a real name."
        )
        fix.append(
            "Run perf script again on the same server, with the binary and its libraries still installed. "
            "A perf.script file copied alone often keeps addresses and loses every symbol."
        )
        fix.append(
            "Or run perf archive perf.data on the server and send perf.data.tar.bz2 with perf.data. "
            "On the analysis machine, extract it into ~/.debug (tar xf perf.data.tar.bz2 -C ~/.debug) before perf script."
        )
        fix.append(
            "Install debug symbols for the server binary and for glibc, or repeat the capture with a build that is not stripped."
        )
        fix.append(
            "Record with sudo perf record -a -g -F99 -p $(pgrep -d, -x <binary>) -- sleep 60. "
            "If the new stacks are still one frame deep, use --call-graph dwarf, or a binary built with frame pointers."
        )
        fix.append("Do not tune queries, indexes, or configuration from this graph. There is no named function to change yet.")
    if libc_unknown and unknown_finding is not None:
        unusual.append(
            "libc and the threading library are unnamed too. A stripped application usually still shows libc names "
            "such as malloc or pthread_mutex_lock. Here symbol lookup failed for the whole capture, not just the server binary."
        )
    if kernel_unknown and unknown_finding is not None:
        unusual.append(
            "Kernel frames are also [unknown]. perf could not read kernel symbols, so this is not only a missing application package."
        )
    if unknown_finding is not None and share(report.kernel_self, busy) < 15:
        unusual.append(
            f"Kernel time is only {share(report.kernel_self, busy):.1f}%. "
            "This is not a kernel or interrupt problem. The samples are inside the server, with the names missing."
        )

    unusual.extend(profile_notes(report))

    for name, samples in report.processes:
        pct = share(samples, busy) if busy else 0
        if name.startswith("connections (") and pct >= 50:
            unusual.append(
                f"{name} hold {pct:.1f}% of the samples. CPU time is spread across client threads, not one background job."
            )
        elif pct >= 20 and not name.startswith("other ("):
            unusual.append(f"{name} alone is {pct:.1f}% of on-CPU time, which is a large share for a single thread.")

    for finding in report.findings:
        if finding is unknown_finding:
            continue
        wrong.append(sentence_case(finding.title) + ".")
        for step in finding.steps:
            if not is_action(step):
                continue
            sentence = sentence_case(step)
            if not sentence.endswith("."):
                sentence += "."
            if sentence not in fix:
                fix.append(sentence)

    if not wrong:
        wrong.append("No single function crossed the hotspot line.")
        fix.append("Read the widest frame whose children split the time. That is where the work fans out.")
    if not unusual:
        unusual.append("Nothing else in the shape of this profile stands out.")
    return wrong, fix, unusual


