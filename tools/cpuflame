   Next: the cost is in this compression code. The caller is compress.
'''

def cmd_selftest(_args: argparse.Namespace) -> None:
    checks = 0

    def expect(condition: bool, message: str) -> None:
        nonlocal checks
        checks += 1
        if not condition:
            raise SystemExit(f"self-test failed: {message}")

    script = """\
# captured for the self-test
python 100 [003] 10.500000:     250000 cpu-clock:
	7ff1 decode_utf8+0x10 (/usr/lib/libc.so.6)
	7ff1 parse_json+0x22 (/home/app/python)
	7ff1 handle_request+0x33 (/home/app/python)

python 100 [003] 10.510000: cycles:
	ffffffff81001234 do_syscall_64+0x1c ([kernel.kallsyms])
	7ff1 read+0x10 (/usr/lib/libc.so.6)
	7ff1 main+0x5 (/home/app/python)

python 100 10.520000: cpu-clock:
	7fabc std::vector<int>::push_back(int)+0x20 (/usr/lib/libstdc++.so.6)
	7fabc [unknown] (/usr/lib/x86_64-linux-gnu/libc.so.6)
	7fabc main+0x5 (/home/app/python)

other 8 [001] 10.530000:          1 cpu-clock:
	5555 clock_nanosleep+0x1 (/usr/lib/libc.so.6)
"""
    tree = load_perf_script(script, include_comm=True, comm_filter=set())
    expect(tree.samples == 4, f"expected 4 samples, got {tree.samples}")
    decode = find_frame(tree, "decode_utf8")
    expect(decode is not None and decode.samples == 1, "decode_utf8 missing")
    expect(find_frame(tree, "python") is not None, "comm frame missing")
    syscall = find_frame(tree, "do_syscall_64")
    expect(syscall is not None and syscall.frame.kind == "kernel", "kernel kind missing")
    vector = find_frame(tree, "std::vector<int>::push_back(int)")
    expect(vector is not None, "C++ symbol was not kept")
    unknown = find_frame(tree, "[unknown] libc.so.6")
    expect(unknown is not None, "unknown module frame missing")
    handle = find_frame(tree, "handle_request")
    parse = find_frame(tree, "parse_json")
    expect(handle is not None and parse is not None and parse in handle.children.values(), "stack was not reversed")

    filtered = load_perf_script(script, include_comm=False, comm_filter={"other"})
    expect(filtered.samples == 1, "comm filter failed")
    expect(find_frame(filtered, "other") is None, "--no-comm still inserted a comm frame")
    expect(find_frame(filtered, "clock_nanosleep") is not None, "filtered stack missing")

    folded = "python;main;malloc 3\npython;main;free 1\n# comment\n\nworker;loop 2.5\n"
    folded_tree = load_text(folded, "auto", include_comm=True, comm_filter=set())
    expect(detect_format(folded) == "folded", "folded file detected as script")
    expect(detect_format(script) == "script", "perf script detected as folded")
    expect(find_frame(folded_tree, "malloc").samples == 3, "folded count mismatch")
    expect(find_frame(folded_tree, "loop").samples == 2.5, "fractional folded count mismatch")

    boxes = layout(example_tree(), 1200, 0.25, icicle=False)
    by_name = {box.name: box for box in boxes}
    expect(by_name["index_scan"].width > by_name["deflate"].width, "wider stack is not wider on screen")
    expect(by_name["vfs_read"].y < by_name["read"].y, "callee should sit above its caller")
    icicle_boxes = {box.name: box for box in layout(example_tree(), 1200, 0.25, icicle=True)}
    expect(icicle_boxes["vfs_read"].y > icicle_boxes["read"].y, "icicle callee should sit below its caller")
    expect(color_for("malloc", "user") == color_for("malloc", "user"), "colors are not stable")
    expect(color_for("malloc", "user") != color_for("vfs_read", "kernel"), "kernel and user share a color")

    with tempfile.TemporaryDirectory() as temp_dir:
        path = os.path.join(temp_dir, "out.svg")
        root = example_tree()
        emit_quiet = os.path.abspath(path)
        boxes = layout(root, 1000, 0.25, False)
        write_svg(path, boxes, root.samples, "Example flame graph", 1000)
        import xml.etree.ElementTree as ET

        ET.parse(path)
        svg = open(path, encoding="utf-8").read()
        expect("index_scan" in svg and "init()" in svg and "Reset zoom" in svg, "svg is missing expected pieces")
        expect(os.path.exists(emit_quiet), "svg was not written")

    example_report = render_report(analyze(example_tree(), 8))
    expect(example_report == EXAMPLE_REPORT, "example report drifted from the golden text")
    wide = example_report.split("Widest frames\n", 1)[1].split("\nHottest self time", 1)[0]
    for line in wide.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            expect(
                parts[1] not in {"main", "index_scan", "bson", "fetch"},
                "pass-through frame listed as widest: " + line,
            )
    expect("serve" in wide and "handle" in wide, "widest list dropped a real split")

    def stacked(rows):
        root = Node(Frame("all", "root"))
        for frames, weight in rows:
            add_sample(root, frames, weight)
        return render_report(analyze(root, 8))

    def user(name):
        return Frame(name, "user")

    def kernel(name):
        return Frame(name, "kernel")

    def comm(name):
        return Frame(name, "comm")

    expect(not is_alloc("free_pages"), "free_pages matched the allocator")
    expect(not is_alloc("__free_one_page"), "kernel page free matched the allocator")
    expect(not is_alloc("free_unref_page"), "free_unref_page matched the allocator")
    expect(not is_alloc("buffer_free"), "buffer_free matched the allocator")
    expect(is_alloc("__libc_free") and is_alloc("_int_malloc"), "libc allocator names were missed")
    expect(is_copy("__memmove_avx_unaligned_erms"), "AVX memmove was missed")
    expect(not is_copy("copy_page_range"), "copy_page_range matched copy_page")
    expect(end_run_match("clear_page_erms", "clear_page"), "clear_page_erms tail was missed")
    expect(not matches_rules("parse_args", PARSE_RULES), "parse_args matched parsing")
    expect(not matches_rules("sparse_map", PARSE_RULES), "sparse_map matched parsing")
    expect(not matches_rules("sparse_map", ALLOC_RULES), "sparse_map matched the allocator")
    expect(
        matches_rules("parse_json", PARSE_RULES) and matches_rules("parse_json_internal", PARSE_RULES),
        "parse_json prefix missed",
    )
    expect(is_lock("_raw_spin_lock_irqsave"), "spinlock prefix missed")
    expect(is_lock("ut_delay") and is_lock("s_lock") and is_lock("perform_spin_delay"), "database spin names missed")
    expect(is_lock("LWLockAcquireOrWait") and is_lock("rw_lock_s_lock_spin"), "database lock prefix missed")
    expect(not is_lock("rw_lock_create"), "rw_lock_create matched a spin")

    free_pages = stacked([([comm("app"), kernel("free_pages")], 100)])
    expect("allocation rate" not in free_pages, "free_pages became an allocator finding")
    expect("parsing" not in stacked([([comm("app"), user("parse_args")], 100)]), "parse_args became a parsing finding")
    expect("parsing" not in stacked([([comm("app"), user("sparse_map")], 100)]), "sparse_map became a parsing finding")

    spread = stacked([
        ([comm("app"), user("main"), user("work"), user("left"), user("a")], 20),
        ([comm("app"), user("main"), user("work"), user("left"), user("b")], 15),
        ([comm("app"), user("main"), user("work"), user("left"), user("c")], 15),
        ([comm("app"), user("main"), user("work"), user("right"), user("d")], 20),
        ([comm("app"), user("main"), user("work"), user("right"), user("e")], 15),
        ([comm("app"), user("main"), user("work"), user("right"), user("f")], 15),
    ])
    expect("time is spread out under left" in spread, "spread pointed at the wrong frame")
    expect("under main" not in spread, "spread pointed at main")

    tied = stacked([
        ([comm("app"), user("m_leaf")], 40),
        ([comm("app"), user("z_leaf")], 40),
        ([comm("app"), user("other")], 20),
    ])
    expect("Hottest path\n  app → m_leaf\n" in tied, "hottest-path tie broke the wrong way")

    idle = stacked([
        ([comm("swapper/0"), kernel("do_idle")], 50),
        ([comm("mysqld"), user("malloc")], 50),
    ])
    expect("swapper" in idle and "excluded below" in idle, "idle was not excluded")
    expect("malloc is 100.0% of self time" in idle, "idle samples stayed in the denominator")
    expect("cut the allocation rate" in idle and "optimize malloc first" in idle, "idle malloc finding was not merged")

    hidden = load_perf_script(
        "app 1 [000] 1.500000: cycles:\n\t7ff1 foo+0x10 (/usr/bin/app)\n",
        include_comm=False,
        comm_filter=set(),
    )
    hidden_report = render_report(analyze(hidden, 8))
    expect("process names were not recorded" in hidden_report, "--no-comm still named a process")
    expect(find_frame(hidden, "app") is None, "--no-comm inserted a comm frame")

    plain = load_folded("main;foo;bar 12\n", set(), True)
    expect(find_frame(plain, "main").frame.kind == "user", "plain folded main was recolored")
    marked = load_folded("python;main;malloc_[k] 4\npython;main;free 1\n", set(), True)
    expect(find_frame(marked, "python").frame.kind == "comm", "stackcollapse process frame")
    expect(find_frame(marked, "malloc").frame.kind == "kernel", "_[k] was not kernel")
    expect(find_frame(marked, "free").frame.kind == "user", "unmarked folded frame became kernel")
    expect(find_frame(marked, "malloc").samples == 4, "_[k] suffix stayed in the name")

    ev = user("_PyEval_EvalFrameDefault")
    py = stacked([
        ([comm("python"), ev, ev, ev, ev, ev, ev], 80),
        ([comm("python"), user("other")], 20),
    ])
    expect("python -X perf" in py, "interpreter frames were not called out")
    expect("optimize _PyEval_EvalFrameDefault" not in py, "interpreter frame was treated as user code")
    expect("repeats" not in py, "interpreter repeats looked like recursion")

    fault = stacked([
        ([comm("python"), user("main"), kernel("exc_page_fault"), kernel("do_user_addr_fault"), kernel("clear_page_erms")], 20),
        ([comm("python"), user("other")], 80),
    ])
    expect("exc_page_fault is 20.0% of inclusive time" in fault, "page-fault entry was missed")
    expect("The hottest frame is clear_page_erms." in fault, "page-fault self time was missed")
    expect("cut copies" not in fault, "clear_page_erms was reported as a copy")

    tcp = stacked([
        ([comm("mysqld"), user("send"), kernel("entry_SYSCALL_64"), kernel("do_syscall_64"), kernel("__x64_sys_sendto"), kernel("tcp_sendmsg")], 30),
        ([comm("mysqld"), user("other")], 70),
    ])
    expect("syscalls spend it in tcp_sendmsg (network)." in tcp, "syscall time was not labeled")

    thp = stacked([
        ([comm("kcompactd0"), kernel("compact_zone"), kernel("isolate_migratepages_block")], 30),
        ([comm("mysqld"), user("other")], 70),
    ])
    expect("transparent huge pages or memory reclaim" in thp, "compaction was left unlabeled")

    spinning = stacked([
        ([comm("mysqld"), user("row_search"), user("ut_delay")], 20),
        ([comm("mysqld"), user("other")], 80),
    ])
    expect("the CPU is spinning in ut_delay" in spinning and "off-CPU" in spinning, "ut_delay was not a spin finding")

    merged = stacked([
        ([comm("app"), user("malloc")], 40),
        ([comm("app"), user("a")], 20),
        ([comm("app"), user("b")], 20),
        ([comm("app"), user("c")], 20),
    ])
    numbered = [line for line in merged.splitlines() if len(line) > 2 and line[0].isdigit() and line[1] == "."]
    expect(len(numbered) == 1, "malloc dominate and allocator stayed two findings")
    expect("optimize malloc first" in merged and "cut the allocation rate" in merged, "merged malloc steps missing")

    beneath_new = stacked([
        ([comm("app"), user("build"), Frame("operator new(unsigned long)", "user"), user("_int_malloc"), user("malloc")], 10),
        ([comm("app"), user("other")], 90),
    ])
    expect("The caller is build." in beneath_new, "allocator caller stopped inside operator new")

    split_alloc = stacked([
        ([comm("app"), user("a"), user("malloc")], 3),
        ([comm("app"), user("b"), user("free")], 3),
        ([comm("app"), user("c"), user("calloc")], 3),
        ([comm("app"), user("work")], 91),
    ])
    expect("matching frames add up to 9.0% of self time." in split_alloc, "split allocator time was not summed")

    expect(default_report_path("out.svg") == "out.txt", "svg report path")
    expect(default_report_path("out.SVG") == "out.txt", "SVG report path")
    expect(default_report_path("out") == "out.txt", "bare report path")
    flags = build_parser().parse_args(["run", "--record-only", "--no-report", "-o", "out", "--", "true"])
    expect(flags.record_only and flags.no_report, "record-only with --no-report")
    expect(build_parser().prog == "cpuflame", "tool name")
    expect(is_lock("absl::lts_20230802::base_internal::SpinLock::SpinLoop()"), "abseil spin was missed")
    repeated = Node(Frame("all", "root"))
    add_sample(
        repeated,
        [Frame("app", "comm"), Frame("foo", "user"), Frame("bar", "user"), Frame("foo", "user")],
        10,
    )
    repeated_report = analyze(repeated, 8)
    foo_width = [samples for samples, name, _path in repeated_report.widest if name == "foo"]
    expect(foo_width == [10], "the same sample was counted twice in one function")
    many = Node(Frame("all", "root"))
    add_sample(many, [Frame("conn1", "comm"), Frame("work", "user")], 50)
    add_sample(many, [Frame("conn2", "comm"), Frame("work", "user")], 30)
    add_sample(many, [Frame("Checkpointer", "comm"), Frame("work", "user")], 20)
    grouped = analyze(many, 8)
    labels = [name for name, _samples in grouped.processes]
    expect(any(name.startswith("connections (2 threads)") for name in labels), "connection threads were not grouped")
    expect("conn1" not in labels and "conn2" not in labels, "individual connections were still listed")
    report_flags = build_parser().parse_args(["report", "-i", "stacks.txt", "--top", "3"])
    expect(report_flags.func == cmd_report and report_flags.top == 3, "report command")

    import io
    from contextlib import redirect_stdout

    with tempfile.TemporaryDirectory() as temp_dir:
        svg = os.path.join(temp_dir, "example.svg")
        with redirect_stdout(io.StringIO()):
            main(["example", "-o", svg])
        report_path = os.path.join(temp_dir, "example.txt")
        expect(os.path.exists(svg), "example svg missing")
        expect(os.path.exists(report_path), "example report missing")
        expect(open(report_path, encoding="utf-8").read() == EXAMPLE_REPORT, "example file is not the golden report")
        svg_only = os.path.join(temp_dir, "quiet.svg")
        with redirect_stdout(io.StringIO()):
            main(["example", "-o", svg_only, "--no-report"])
        expect(not os.path.exists(os.path.join(temp_dir, "quiet.txt")), "--no-report still wrote a report")
        folded = os.path.join(temp_dir, "stacks.txt")
        out = os.path.join(temp_dir, "out.txt")
        with open(folded, "w", encoding="utf-8") as handle:
            handle.write("main;foo;bar 12\n")
        with redirect_stdout(io.StringIO()):
            main(["report", "-i", folded, "-o", out])
        written = open(out, encoding="utf-8").read()
        expect("bar is 100.0% of self time" in written, "report command missed the leaf")
        expect(find_frame(load_folded("main;foo;bar 12\n", set(), True), "main").frame.kind == "user", "report input recolored main")

    print(f"self-test ok ({checks} checks)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="cpuflame",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Record a Linux perf profile, write an interactive flame graph SVG, "
            "and a short report of the hot frames. You do not need flamegraph.pl."
        ),
        epilog="""examples:
  cpuflame check
  cpuflame example -o example.svg --open
  cpuflame run -o app.svg -- python3 app.py
  cpuflame run -d 15 -F 99 -o app.svg -- python3 app.py
  cpuflame attach -p 1234 -d 20 -o proc.svg
  cpuflame system -d 10 -o system.svg
  cpuflame graph -i perf.data -o out.svg
  cpuflame report -i perf.data
  cpuflame report -i stacks.txt -o report.txt
  perf script -i perf.data | cpuflame graph -i - -o out.svg
  cpuflame graph -i stacks.txt -o out.svg

folded stacks look like:  main;foo;bar 12
""",
    )
    view = argparse.ArgumentParser(add_help=False)
    view.add_argument("-o", "--output", default="cpuflame.svg", help="SVG to write (default: cpuflame.svg)")
    view.add_argument("--title", default="", help="Title drawn above the graph")
    view.add_argument("--width", type=int, default=1200, help="Image width in pixels (default: 1200)")
    view.add_argument("--min-width", type=float, default=0.25, help="Hide frames narrower than this many pixels")
    view.add_argument("--icicle", action="store_true", help="Put the root at the top instead of the bottom")
    view.add_argument("--open", action="store_true", help="Open the SVG in a browser when it is ready")

    filt = argparse.ArgumentParser(add_help=False)
    filt.add_argument("--no-comm", action="store_true", help="Do not add the process name at the base of each stack")
    filt.add_argument("--comm", action="append", default=[], help="Keep only this process name (repeatable)")

    record = argparse.ArgumentParser(add_help=False)
    record.add_argument("-F", "--freq", type=int, default=99, help="Samples per second (default: 99)")
    record.add_argument("--call-graph", choices=["fp", "dwarf", "lbr"], default="fp", help="Stack unwinder (default: fp)")
    record.add_argument("--keep", action="store_true", help="Also save perf.data next to the SVG")
    record.add_argument(
        "--record-only",
        action="store_true",
        help="Save perf.data and stop. Implies --keep. No SVG and no report",
    )

    words = argparse.ArgumentParser(add_help=False)
    words.add_argument("--report", default="", help="Write the report here. Default: the SVG path with .txt")
    words.add_argument("--no-report", action="store_true", help="Do not write the report")
    words.add_argument("--top", type=int, default=8, help="Rows in the widest and self-time lists (default: 8)")

    sub = parser.add_subparsers(dest="cmd", required=True)

    run = sub.add_parser("run", parents=[view, filt, record, words], help="Record a command, write a flame graph, and write a report")
    run.add_argument("-d", "--duration", type=float, help="Stop recording after this many seconds")
    run.add_argument("command", nargs=argparse.REMAINDER, help="Command to record, after --")
    run.set_defaults(func=cmd_run)

    attach = sub.add_parser("attach", parents=[view, filt, record, words], help="Record a running process")
    attach.add_argument("-p", "--pid", type=int, required=True, help="Process id to record")
    attach.add_argument("-d", "--duration", type=float, default=10, help="Seconds to record (default: 10)")
    attach.set_defaults(func=cmd_attach)

    system = sub.add_parser("system", parents=[view, filt, record, words], help="Record every CPU")
    system.add_argument("-d", "--duration", type=float, default=10, help="Seconds to record (default: 10)")
    system.set_defaults(func=cmd_system)

    graph = sub.add_parser("graph", parents=[view, filt], help="Draw a flame graph from perf.data, perf script, or folded stacks")
    graph.add_argument("-i", "--input", default="perf.data", help="perf.data, a perf script dump, folded stacks, or - for stdin")
    graph.add_argument("--format", choices=["auto", "script", "folded"], default="auto")
    graph.set_defaults(func=cmd_graph)

    example = sub.add_parser("example", parents=[view, words], help="Write a sample flame graph and report, no perf required")
    example.set_defaults(func=cmd_example)

    report = sub.add_parser("report", parents=[filt], help="Write the performance report, no SVG")
    report.add_argument("-i", "--input", default="perf.data", help="perf.data, a perf script dump, folded stacks, or - for stdin")
    report.add_argument("--format", choices=["auto", "script", "folded"], default="auto")
    report.add_argument("-o", "--output", default="", help="Also write the report to this file")
    report.add_argument("--top", type=int, default=8, help="Rows in the widest and self-time lists (default: 8)")
    report.set_defaults(func=cmd_report)

    check = sub.add_parser("check", help="Say whether this user can record with perf")
    check.set_defaults(func=cmd_check)

    test = sub.add_parser("self-test", help="Check the parser and SVG writer")
    test.set_defaults(func=cmd_selftest)
    return parser


def main(argv: list[str] | None = None) -> None:
    parser = build_parser()
    args = parser.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
