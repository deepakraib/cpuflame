    count = report.sample_count or report.total
    wrong, fix, unusual = conclusion_points(report)

    if report.findings:
        top = report.findings[0]
        verdict = sentence_case(top.title) + "."
        if top.title.startswith("[unknown]"):
            verdict = (
                f"This capture cannot be used for tuning yet: {top.pct:.1f}% of on-CPU time has no function names."
            )
        top_sev = finding_severity(top)
    else:
