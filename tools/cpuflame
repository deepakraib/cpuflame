SEVERITY_LABELS = {"critical": "High impact", "serious": "Medium impact", "warning": "Low impact"}


def finding_category(finding: Finding) -> str:
    key = finding.key
    if key.startswith("stage:"):
        return "Query stage"
    if key.startswith("alloc:") or "allocation" in finding.title or any("allocation rate" in step for step in finding.steps):
        return "Allocator"
    if finding.title.startswith("[unknown]"):
        return "Missing symbols"
    if key.startswith("kernel:") or finding.title.startswith("perf overhead"):
        return "Kernel"
    if key.startswith("deep:"):
        return "Recursion"
    if key.startswith("spread:"):
        return "No single hotspot"
    if any("spinning in" in step for step in finding.steps):
        return "Lock spin"
    if any("cut copies" in step for step in finding.steps):
        return "Memory copies"
    if any("touching new memory" in step for step in finding.steps):
        return "Page faults"
    if any("eval loop" in step for step in finding.steps):
        return "Interpreter"
    if any(step.startswith("the cost is in this") for step in finding.steps):
        return "Library"
    return "CPU hotspot"


def finding_severity(finding: Finding) -> str:
    if finding.title.startswith("[unknown]"):
        return "critical"
    if finding.pct >= 30:
        return "critical"
    if finding.pct >= 10:
        return "serious"
    return "warning"


def _path_chips(path: str) -> str:
    parts = [part for part in path.split(" → ") if part]
    chips = []
    for index, part in enumerate(parts):
        if index:
            chips.append('<span class="sep" aria-hidden="true">›</span>')
        if part == "…":
            chips.append('<span class="sep" title="frames left out">…</span>')
        else:
            chips.append(f"<code>{escape(part)}</code>")
    return "".join(chips)


def _highlight_term(finding: Finding) -> str:
    parts = [part for part in finding.path.split(" → ") if part and part != "…"]
    raw = parts[-1] if parts else finding.title.split(" is ", 1)[0]
    if raw.startswith("[unknown] "):
        return raw
    return re.sub(r"\(.*$", "", raw)[:120] or raw


def render_html(report: Report, svg_markup: str, icicle: bool = False) -> str:
